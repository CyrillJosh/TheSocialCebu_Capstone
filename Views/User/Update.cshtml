@using TheSocialCebu_Capstone.ViewModels
@{
    ViewData["Title"] = "User Management";
}

@model PersonUpdateVM

<div class="render-body vh-100 vw-100">
    <div class="p-4 h-100 w-100">
        <form method="post" asp-controller="User" asp-action="Update" class="has-validation" novalidate>
            <!-- HIDDEN -->
            <input asp-for="PersonId" type="hidden" />

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label text-dark" asp-for="Name">Name</label>
                    <input class="form-control bg-body-secondary" asp-for="Name" type="text" required placeholder="Name" />
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-dark" asp-for="Gender">Gender</label>
                    <input class="form-control bg-body-secondary" asp-for="Gender" type="text" required placeholder="Gender" />
                    <span class="text-danger" asp-validation-for="Gender"></span>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-dark" asp-for="BirthDate">Birth Date</label>
                    <input class="form-control bg-body-secondary"
                           asp-for="BirthDate"
                           type="date"
                           min="1900-01-01"
                           max="@DateTime.Now.ToString("yyyy-MM-dd")"
                           required />
                    <span class="text-danger" asp-validation-for="BirthDate"></span>
                </div>

                <div class="col-md-12">
                    <label class="form-label text-dark" asp-for="RoleId">Role</label>
                    <select class="form-select bg-body-secondary" asp-for="RoleId" required>
                        <option value="">-- Select Role --</option>
                        @foreach (var r in Model.Roles)
                        {
                            if (r.RoleId == Model.RoleId)
                            {
                                <option value="@r.RoleId" selected>@r.RoleName</option>
                            }
                            else
                            {
                                <option value="@r.RoleId">@r.RoleName</option>
                            }
                        }
                    </select>
                    <span class="text-danger" asp-validation-for="RoleId"></span>
                </div>
                <div class="col-md-12 rounded-2 py-2 d-flex gap-5 align-items-center bg-body-secondary">
                    <label class="d-block text-dark">Status</label>
                    <div class="btn-group" role="group" aria-label="Stock status">
                        <input type="radio"
                               class="btn-check"
                               name="Status"
                               id="StatusTrue"
                               value="true"
                               autocomplete="off"
                               @(Model.Status ? "checked" : "") />
                        <label class="btn btn-outline-success" for="StatusTrue">Available</label>

                        <input type="radio"
                               class="btn-check"
                               name="Status"
                               id="StatusFalse"
                               value="false"
                               autocomplete="off"
                               @(!Model.Status ? "checked" : "") />
                        <label class="btn btn-outline-danger" for="StatusFalse">Unavailable</label>
                    </div>
                </div>



                <button class="btn btn-success col-12 my-5" type="submit">Update</button>
            </div>
        </form>
    </div>
</div>
