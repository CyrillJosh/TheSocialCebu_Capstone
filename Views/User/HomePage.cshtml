@using TheSocialCebu_Capstone.Models
@model List<Person>

@{
    ViewData["Title"] = "User Management";
}
<div class="render-body">
    <div class="p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="mb-0 fw-bold text-primary">User Management</h2>
            <a asp-controller="User" asp-action="Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Create User
            </a>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Date hired</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in Model)
                    {
                        <tr>
                            <td>@person.PersonId</td>
                            <td>@person.Name</td>
                            <td>@person.Account.Username</td>
                            <td>••••••••</td>
                            <td>@person.HiredDate.ToString("yyyy-MM-dd")</td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="User" asp-action="Update" asp-route-id="@person.PersonId"
                                       class="btn btn-sm btn-outline-primary px-3">
                                        <i class="bi bi-pencil-square">Edit</i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger px-3 DeleteModalButton"
                                            data-id="@person.PersonId" data-bs-toggle="modal" data-bs-target="#DeleteModal">
                                        <i class="bi bi-trash">Delete</i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedId = null;

        $('.DeleteModalButton').on('click', function () {
            selectedId = $(this).data("id");
        });

        $('#ConfirmDelete').on('click', function () {
            if (!selectedId) return;

            $.ajax({
                url: `/User/Delete/${selectedId}`,
                type: "DELETE",
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while processing the request.");
                }
            });
        });

         $('#Table').DataTable({
                scrollY: 'calc(100vh - 200px)', // adjust 200px to account for header/search/buttons
                scrollCollapse: true,
                paging: false, // optional if you want no pagination
                searching: true, // keep built-in search
                info: false, // hide "Showing 1 of X"
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                info: true,
                language: {
                    search: "",
                    searchPlaceholder: "Search Products",
                },
                 dom: 'lrtip',
                    columnDefs: [
                    { targets: 'no-sort', orderable: false },
                    {
                        targets:  2,
                        render: function (data, type, row) {
                            if(type === 'sort' || type === 'type') {
                                return parseFloat(data.replace(/[^0-9.\-]+/g,"")) || 0;
                            }
                            return data;
                        }
                    }
                ]
            });
    </script>
}
