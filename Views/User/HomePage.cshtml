@using TheSocialCebu_Capstone.Models
@model List<Person>

@{
    ViewData["Title"] = "User Management";
}
<div class="render-body">
    <div class="p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-dark fw-bold">EMPLOYEE</h1>
            <a asp-controller="User" asp-action="Create" class="btn btn-primary px-5 rounded rounded-pill">
                Create User
            </a>
        </div>

        <!-- Table -->
        <div class="flex-grow-1 overflow-auto table-responsive">
            <table class="table table-hover h-auto align-middle rounded table-separate h-100" id="Table">
                <thead class="sticky-top">
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Password</th>
                        <th>Date hired</th>
                        <th style="width: 150px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in Model)
                    {
                        <tr>
                            <td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary">@person.PersonId</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@person.Name</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@person.Account.Username</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">••••••••</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@person.HiredDate.ToString("yyyy-MM-dd")</td>
                            <td class="border-2 border-start-0 border-secondary bg-body rounded-end bg-body-secondary">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-controller="User" asp-action="Update" asp-route-id="@person.PersonId"
                                       class="btn btn-sm btn-outline-primary px-3">
                                        <i class="bi bi-pencil-square">Edit</i>
                                    </a>
                                    <button class="btn btn-sm btn-outline-danger px-3 DeleteModalButton"
                                            data-id="@person.PersonId" data-bs-toggle="modal" data-bs-target="#DeleteModal">
                                        <i class="bi bi-trash">Delete</i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedId = null;

        $('.DeleteModalButton').on('click', function () {
            selectedId = $(this).data("id");
        });

        $('#ConfirmDelete').on('click', function () {
            if (!selectedId) return;

            $.ajax({
                url: `/User/Delete/${selectedId}`,
                type: "DELETE",
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while processing the request.");
                }
            });
        });

         $('#Table').DataTable({
            paging: false,
            searching: true,
            info: false,
            pageLength: 10,
            lengthChange: false,
            ordering: true,
            dom: 'lrtip',
            columnDefs: [
                { targets: 'no-sort', orderable: false }
            ],
            language: {
                search: "",
                searchPlaceholder: "Search Tables",
            }
        });
    </script>
}
