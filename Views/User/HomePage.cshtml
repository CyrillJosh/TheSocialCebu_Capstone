@using TheSocialCebu_Capstone.Models
@model List<Person>

@{
    ViewData["Title"] = "User Management";
}
<div class="render-body">
    <div class="p-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-dark fw-bold">EMPLOYEE</h1>
            <a asp-controller="User" asp-action="Create" class="btn btn-primary px-5 rounded rounded-pill text-black">
                + Create User
            </a>
        </div>

        <!-- Table -->
        <div class="flex-grow-1 overflow-auto table-responsive">
            <table class="table table-hover h-auto align-middle rounded table-separate h-100" id="Table">
                <thead class="sticky-top">
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        @* <th>Password</th> *@
                        <th>Date hired</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var person in Model)
                    {
                        <tr>
                            <td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary">@person.Name</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@person.Account.Username</td>
                            @* <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">
                                <button id="@person.PersonId" class="btn btn-danger rounded d-flex flex-row nowrap align-content-center align-items-center justify-content-center gap-2">
                                    <p class="m-0 p-0">Reset</p>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-clockwise m-0 p-0" viewBox="0 0 16 16">
                                        <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z" />
                                        <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466" />
                                    </svg>
                                </button>
                            </td> *@
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@person.HiredDate.ToString("yyyy-MM-dd")</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">
                                @(person.Status? "Active": "Inactive")
                            </td>
                            <td class="border-2 border-start-0 border-secondary bg-body rounded-end bg-body-secondary">
                                <div class="d-flex justify-content-center gap-2">
                                    <a asp-action="Update" asp-route-id="@person.PersonId" asp-controller="User" class="btn btn-sm btn-outline-primary border-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                        </svg>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger DeleteProduct border-0" data-id="@person.PersonId" data-bs-toggle="modal" data-bs-target="#DeleteModal">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header">
                <h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this user?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="ConfirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let selectedId = null;

        // When delete button is clicked, get the data-id
        $('.DeleteProduct').on('click', function () {
            selectedId = $(this).data('id');
        });

        // When ConfirmDelete button in modal is clicked
        $('#ConfirmDelete').on('click', function () {
            if (!selectedId) return;

            $.ajax({
                url: `/User/Delete/${selectedId}`,
                type: "DELETE",
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        location.reload();
                    } else {
                        alert("Error: " + response.message);
                    }
                },
                error: function () {
                    alert("An error occurred while processing the request.");
                }
            });
        });

         $('#Table').DataTable({
            paging: false,
            searching: true,
            info: false,
            pageLength: 10,
            lengthChange: false,
            ordering: true,
            dom: 'lrtip',
            columnDefs: [
                { targets: 'no-sort', orderable: false }
            ],
            language: {
                search: "",
                searchPlaceholder: "Search Tables",
            }
        });
    </script>
}
