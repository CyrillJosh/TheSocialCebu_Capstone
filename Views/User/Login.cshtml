@using TheSocialCebu_Capstone.ViewModels
@model LoginVM

@{
    ViewData["Title"] = "Login";
}
<div class="vh-100 vw-100 bg-black">
    <div class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="form-signin w-100" style="max-width: 550px;">
            <form method="post" asp-controller="User" asp-action="Login" class="p-4 d-flex flex-column align-items-center">
                <img src="/Images/The Social Logo.png" height="100" width="100"/>
                <h1 class="fw-bold text-center text-white">THE SOCIAL CEBU</h1>
                <p class="mb-3 fst-italic text-white"> It’s not just food, it’s the experience.</p>

                <div class="form-floating mb-3 bg-white rounded-2 w-100">
                    <input type="text" asp-for="Username" class="text-black bg-transparent py-2 px-3 w-100 border-0" placeholder="Username" required autocomplete="off" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3 bg-white rounded-2 w-100">
                    <input type="password" asp-for="Password" class="text-black bg-transparent py-2 px-3 w-100 border-0" id="floatingPassword" placeholder="Password" required autocomplete="off">
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button class="btn btn-primary w-25 py-2 my-3 rounded-2" type="submit">Login</button>
            </form>
        </div>
    </div>
</div>
