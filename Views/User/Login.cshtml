@using TheSocialCebu_Capstone.ViewModels
@model LoginVM

@{
    ViewData["Title"] = "Login";
}
<div class="render-body">
    <div class="d-flex align-items-center justify-content-center min-vh-100">
        <div class="form-signin w-100 shadow" style="max-width: 400px;">
            <form method="post" asp-controller="User" asp-action="Login" class="p-4 rounded shadow-sm">
                <h1 class="h3 mb-4 fw-bold text-center text-dark">Welcome Back</h1>

                <div class="form-floating mb-3">
                    <input type="text" asp-for="Username" class="text-dark py-2 px-3 w-100 rounded-5 border border-1 border-dark" placeholder="Username" required />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" asp-for="Password" class="text-dark py-2 px-3 w-100 rounded-5 border border-1 border-dark" id="floatingPassword" placeholder="Password" required>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" value="remember-me" id="checkDefault">
                    <label class="form-check-label text-dark" for="checkDefault">
                        Remember me
                    </label>
                </div>

                <button class="btn btn-yellow w-100 py-2 rounded-pill" type="submit">Sign In</button>
            </form>
        </div>
    </div>
</div>
