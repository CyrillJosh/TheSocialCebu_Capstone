@using TheSocialCebu_Capstone.Models
@{
    ViewData["Title"] = "Feedback";
}
@model List<Feedback>

<div class="render-body vh-100 vw-100">
    <div class="container p-4 d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-dark fw-bold">FEEDBACK</h1>
            @* <a class="btn btn-primary px-5 rounded rounded-pill text-black" href="/Marketing/Send">
                + Send Emails
            </a> *@
        </div>
        <div class="row g-4 flex-grow-1">
            <!-- Overall -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title text-black">Overall</h5>
                        @{
                            var overall = Model.Select(x => x.Rating).DefaultIfEmpty(0).Average();
                            var overallStars = (int)Math.Round(overall);
                            var overallcount = Model.Count();
                        }
                        <p class="display-6 fw-bold">@overall.ToString("0.00") / @overallcount</p>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= overallStars)
                                {
                                    <span class="text-warning">&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted">&#9733;</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Daily -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title text-success">Daily</h5>
                        @{
                            var daily = Model.Where(x => x.DateCreated.Date == DateTime.Today)
                            .Select(x => x.Rating)
                            .DefaultIfEmpty(0)
                            .Average();
                            var dailyStars = (int)Math.Round(daily);
                            var dailyCount = Model.Where(x => x.DateCreated.Date == DateTime.Today)
                            .Select(x => x.Rating)
                            .DefaultIfEmpty(0)
                            .Count();
                        }
                        <p class="display-6 fw-bold">@daily.ToString("0.00") / @overallcount</p>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= dailyStars)
                                {
                                    <span class="text-warning">&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted">&#9733;</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Weekly -->
            <div class="col-md-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body text-center">
                        <h5 class="card-title text-danger">Weekly</h5>
                        @{
                            var weekly = Model.Where(x => x.DateCreated.Date >= DateTime.Today.AddDays(-7))
                            .Select(x => x.Rating)
                            .DefaultIfEmpty(0)
                            .Average();
                            var weeklyStars = (int)Math.Round(weekly);
                            var weeklyCount = Model.Where(x => x.DateCreated.Date >= DateTime.Today.AddDays(-7))
                            .Select(x => x.Rating)
                            .Count();
                        }
                        <p class="display-6 fw-bold">@weekly.ToString("0.00") / @weeklyCount</p>
                        <div>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= weeklyStars)
                                {
                                    <span class="text-warning">&#9733;</span>
                                }
                                else
                                {
                                    <span class="text-muted">&#9733;</span>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-12 flex-grow-1 h-100 d-flex flex-column gap-2 ps-3">
                <hr />
                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">5 ★</span>
                    <div class="progress flex-grow-1" style="height: 50px;">
                        <div class="progress-bar text-dark" role="progressbar"
                             style="background-color: #E5B400 ;width: @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 5) * 100 / Model.Count())))%">
                            @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 5) * 100 / Model.Count())))%
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">4 ★</span>
                    <div class="progress flex-grow-1" style="height: 50px;">
                        <div class="progress-bar text-dark" role="progressbar"
                             style="background-color: #FFC71D ;width: @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 4) * 100 / Model.Count())))%">
                            @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 4) * 100 / Model.Count())))%
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">3 ★</span>
                    <div class="progress flex-grow-1" style="height: 50px;">
                        <div class="progress-bar text-dark" role="progressbar"
                             style="background-color: #FFDF39 ;width: @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 3) * 100 / Model.Count())))%">
                            @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 3) * 100 / Model.Count())))%
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">2 ★</span>
                    <div class="progress flex-grow-1" style="height: 50px;">
                        <div class="progress-bar text-dark" role="progressbar"
                             style="background-color: #FFF56C ;width: @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 2) * 100 / Model.Count())))%">
                            @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 2) * 100 / Model.Count())))%
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="text-dark fw-bold">1 ★</span>
                    <div class="progress flex-grow-1" style="height: 50px;">
                        <div class="progress-bar text-dark" role="progressbar"
                             style="background-color: #FFF9A2 ;width: @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 1) * 100 / Model.Count())))%">
                            @((Model.Count() == 0 ? 0 : (Model.Count(x => x.Rating == 1) * 100 / Model.Count())))%
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>
