@using TheSocialCebu_Capstone.Models
@model List<Table>

@{
	ViewData["Title"] = "Tables";
}
<div class="render-body vh-100 vw-100">
	<div class="h-100 w-100 p-4 d-flex flex-column">
		<div class="d-flex justify-content-between align-items-center mb-4">
			<h2 class="text-dark fw-semibold">Tables</h2>
			<a asp-action="Create" class="btn btn-primary px-4 rounded-pill">+ Create New Table</a>
		</div>
		<div class="flex-grow-1 overflow-auto table-responsive">
			<table class="table table-hover h-auto align-middle rounded table-separate h-100" id="Table">
				<thead class="sticky-top">
					<tr>
						<th class="col">Table Number</th>
						<th class="col">Location</th>
						<th class="col">Status</th>
						<th class="col">QR Code</th>
						<th class="col">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model)
					{
						<tr>
							<td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary ps-5 h3">@item.TableNumber</td>
							<td class="border-2 border-end-0 border-start-0 border-secondary text-start bg-body-secondary">@item.Location?.LocationName</td>
							<td class="border-2 border-end-0 border-start-0 border-secondary text-start bg-body-secondary">@item.TableStatus?.StatusName</td>
							<td class="border-2 border-end-0 border-start-0 border-secondary text-start bg-body-secondary">
								@if (item.QrcodeImage != null)
								{
									var base64 = Convert.ToBase64String(item.QrcodeImage);
									<img src="data:image/png;base64,@base64" class="img-thumbnail border-0 rounded" style="width: 80px;" />
								}
								else
								{
									<span class="text-muted fst-italic">No QR</span>
								}
							</td>
							<td class="border-2 border-start-0 border-secondary rounded-end bg-body-secondary">
								<div class="btn-group">
									<a asp-action="Edit" asp-route-id="@item.TableId" class="btn btn-sm btn-outline-primary border-0">
										<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
											<path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
											<path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
										</svg>
									</a>
									<button type="button" class="btn btn-sm btn-outline-danger DeleteTable border-0" data-id="@item.TableId" data-name="@item.TableNumber" data-bs-toggle="modal" data-bs-target="#DeleteModal">
										<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
											<path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
											<path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
										</svg>
									</button>
									<a asp-action="Print" class="btn btn-sm btn-outline-success border-0" asp-route-id="@item.TableId">
										<svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-printer" viewBox="0 0 16 16">
											<path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1" />
											<path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1" />
										</svg>
									</a>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
</div>

<form asp-action="Delete" method="post">
	<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content bg-dark text-white border-secondary rounded">
				<div class="modal-header border-0">
					<h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
					<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					Are you sure you want to delete <strong id="Item"></strong>?
				</div>
				<input type="hidden" name="id" id="DeleteIdInput" />
				<div class="modal-footer border-0">
					<button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancel</button>
					<button type="submit" class="btn btn-danger px-4">Delete</button>
				</div>
			</div>
		</div>
	</div>
</form>

@section Scripts {
	<script>
		$(document).ready(function () {
		$('#Table').DataTable({
			paging: false,
			searching: true,
			info: false,
			pageLength: 10,
			lengthChange: false,
			ordering: true,
			dom: 'lrtip',
			columnDefs: [
				{ targets: 'no-sort', orderable: false }
			],
			language: {
				search: "",
				searchPlaceholder: "Search Tables",
			}
		});

			$(document).on('click', '.DeleteTable', onDeleteTableClick);

			function onDeleteTableClick() {
				const tableid = $(this).data("id");
				const tablename = $(this).data("name");

				$('#Item').text(tablename);
				$('#DeleteIdInput').val(tableid);

				console.log("Deleting product with ID:", tableid, "and Name:", tablename);
			}
		});
	</script>
}