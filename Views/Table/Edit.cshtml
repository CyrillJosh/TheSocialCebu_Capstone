@using TheSocialCebu_Capstone.ViewModels
@model TableVM

@{
    ViewData["Title"] = "Edit";
}
<div class="render-body vh-100 vw-100">
    <div class="p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0 text-dark fw-bold text-antonio">EDIT TABLE</h1>
            <div>
                <button type="submit" form="tableform" class="btn btn-success fw-bold me-2 px-4">Save</button>
                <a asp-action="Index" class="btn btn-secondary px-4">Cancel</a>
            </div>
        </div>
        <form asp-action="Edit" method="post" id="tableform" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" id="TableID"/>
            <input type="hidden" asp-for="QRCodeBase64" id="QRCodeBase64" />

            <div class="form-group mb-3">
                <label asp-for="TableNumber" class="text-dark">Table Number</label>
                <input asp-for="TableNumber" class="form-control bg-body-secondary text-dark border-secondary" id="TableNumber" />
                <span asp-validation-for="TableNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="LocationId" class="text-dark">Location</label>
                <select asp-for="LocationId" class="form-control bg-body-secondary text-dark border-secondary" asp-items="Model.LocationList">
                </select>
                <span asp-validation-for="LocationId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="d-block mb-2 text-dark">Status</label>

                <div class="btn-group border-secondary" role="group" aria-label="Status">
                    @foreach(var stat in Model.StatusList.Where(x => x.StatusName == "Available" || x.StatusName == "Unavailable"))
                    {
                        <input type="radio" class="btn-check" name="StatusId" id="@stat.StatusName" value="@stat.TableStatusId" autocomplete="off" @(Model.StatusId == stat.TableStatusId ? "checked" : "")>
                        <label class="btn btn-outline-success" for="@stat.StatusName">@stat.StatusName</label>
                    }
                </div>

            </div>

            <div class="form-group">
                <label class ="text-dark">QR Code Preview</label><br />
                <img class="border border-secondary rounded" id="qrPreview" src="@("data:image/png;base64," + Convert.ToBase64String(Model.ExistingQRCodeImage ?? new byte[0]))" alt="QR Code Preview" style="max-width: 200px;" />
            </div>


        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
        const tableid = $("#TableID").val()
            // Use the number value from the input field for the API request
            fetch(`/Table/GenerateQRCode?value=${tableid}`)
                .then(response => response.json())
                .then(data => {
                    const preview = document.getElementById('qrPreview');
                    // console.log(data);

                    preview.src = data.qrstring;
                    preview.style.display = 'block';

                    document.getElementById('QRCodeBase64').value = data.qrstring;
                })
                .catch(error => {
                    AlertModal("Error",'Problem generating QR code');
                });
        });
    </script>
}
