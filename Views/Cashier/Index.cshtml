			// 				$("#billbody").html(content);
			// 				$("#BillModal").modal("show");

			// 				setTimeout(() => {
			// 					window.print();
			// 					$("#BillModal").modal("hide");

			// 					// Remove paid table from UI
			// 					$("#" + id).remove();
