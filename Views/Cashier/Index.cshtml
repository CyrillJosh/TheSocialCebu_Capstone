@using TheSocialCebu_Capstone.Models
@using TheSocialCebu_Capstone.ViewModels
@{
	ViewData["Title"] = "Cashier";
}
@model List<BillingVM>
<div class="render-body vh-100">
	<div class="row h-100 p-4">
		<div class="col-7 h-100 d-flex flex-column">
			<h1 class="text-dark fw-bold">PAYMENT</h1>
			<div class="d-flex gap-2 overflow-y-auto h-auto pt-5 ps-3">
				@foreach (var t in Model.Where(x => x.Table.TableStatusId > 1 && x.OrderItems.Count() > 0))
				{
					<div class="border border-1 rounded-4 p-3 hstack bg-body-secondary show"id="@t.Table.TableId">
						<div class="p-2 px-5 bg-primary rounded-3 d-flex justify-content-center align-items-center">
							<h3 class="text-black m-0 py-2 px-5">@t.Table.TableNumber</h3>
						</div>
					</div>
				}
			</div>
		</div>
		<div class="col-5 h-100 border-start">
			<h1 class="text-dark fw-bold">DETAILS</h1>
			<div class="d-flex pt-3">
			@foreach (var t in Model.Where(x => x.Table.TableStatusId > 1 && x.OrderItems.Count() > 0))
			{
					<div class="border border-1 shadow rounded-3 p-3 w-100 details visually-hidden bg-body-secondary" id="@("Details" + t.Table.TableId)">
					<div>
						<div class="p-2 hstack gap-3 me-2">
							<div class="p-2 px-5 bg-primary rounded-3 d-flex justify-content-center align-items-center">
								<h3 class="text-black m-0 py-2 px-5">@t.Table.TableNumber</h3>
							</div>
						</div>
						<div class="w-100 overflow-y-auto d-flex flex-column" style="min-height: 300px">
							<hr />
							<table class="w-100">
								<thead>
									<tr>
										<th class="text-dark">Items</th>
										<th class="text-dark">Qty</th>
										<th class="text-dark">Price</th>
									</tr>
								</thead>
								<tbody id="@("body" + t.Table.TableId)">
									@foreach (var item in t.OrderItems)
									{
										<tr>
											<td class="text-dark">@item.Prod.ProdName</td>
											<td class="text-dark">@item.Quantity</td>
											<td class="text-dark">₱@((item.Prod.Price * item.Quantity))</td>
										</tr>
									}
								</tbody>
							</table>
							<hr />
							<div class="vstack h-auto billbuttons">
									<div class="d-flex flex-row gap-2  mt-auto">
									@if (t.Table.TableStatusId == 3) 
									{
										<button class="btn btn-primary bill flex-fill"
												id="@t.Table.TableId">
											Generate Bill
										</button>
									}
									else if (t.Table.TableStatusId == 4) 
									{
										<button class="btn btn-primary pay flex-fill"
												id="@t.Table.TableId">
											Pay Bill
										</button>
										<button class="btn btn-primary flex-fill disc"
												data-bs-toggle="modal"
												data-bs-target="#DiscountModal"
												id="@t.Table.TableId">
											Apply Discount
										</button>
									}
								</div>
							</div>
						</div>
					</div>
				</div>
			}
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="BillModal" tabindex="-1" aria-labelledby="BillModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
		<div class="modal-content border-secondary rounded">
			<div class="flex-grow-1 p-2 d-flex justify-content-center overflow-y-auto" id="billbody">

			</div>
			<div class="w-100 d-flex flex-row gap-2 px-5 py-2">
				<button class="flex-fill btn btn-light shadow" data-bs-dismiss="modal" aria-label="Close">Back</button>
				<a class="flex-fill btn btn-primary printbill" href="javascript:window.print()">Print</a>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="DiscountModal" tabindex="-1" aria-labelledby="DiscountModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-secondary rounded">
			<div class="flex-grow-1 p-2 d-flex flex-column gap-2 justify-content-center overflow-y-auto form-control">
				<select class="discount flex-fill form-select" id="select">
					<option value="">Select Discount Type</option>
					@foreach (var d in Model.SelectMany(x => x.DiscountTypes))
					{
						<option value="@d.DiscountTypeId">@d.DiscountName</option>
					}
				</select>
				<input type="number" id="nump" class="form-control intonly" placeholder="Number of people" />
				<input type="number" id="appl" class="form-control intonly" placeholder="Number of persons applicable" />
			</div>
			<div class="w-100 d-flex flex-row gap-2 px-5 py-2">
				<button class="flex-fill btn btn-light shadow" data-bs-dismiss="modal" aria-label="Close">Back</button>
				<button class="flex-fill btn btn-primary printwd">Apply</button>
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="PayModal" tabindex="-1" aria-labelledby="PayModal" aria-hidden="true">
	<div class="modal-dialog modal-xl modal-dialog-centered">
		<div class="modal-content border-secondary rounded" style="height: 100vh;">
			<div class="modal-body h-100">
				<div class="row h-100">

					<!-- Left side (bill/receipt preview) -->
					<div class="col-6 h-100 d-flex flex-column">
						<div id="DisplayBody" class="flex-grow-1 p-2 d-flex justify-content-center overflow-y-auto">
							<!-- Receipt content will be injected here -->
						</div>
					</div>

					<!-- Right side -->
					<div class="col-6 h-100 d-flex flex-column border-start">
						<div class="p-2 h-100">

							<!-- Input -->
							<div class="d-flex flex-row gap-2">
								<input type="text" id="amount"
									   class="form-control mb-2"
									   placeholder="Place an amount"
									   style="height: 5%"
									   autocomplete="off" />
								<button id="clear" class="btn btn-warning mb-2" style="height: 5%">
									CLS
								</button>
							</div>

							<!-- Keypad (3×4 grid) -->
							<div id="keypad" class="d-grid mb-2 gap-1"
								 style="grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); flex:1; height: 30%">
								<button class="btn btn-outline-secondary">1</button>
								<button class="btn btn-outline-secondary">2</button>
								<button class="btn btn-outline-secondary">3</button>
								<button class="btn btn-outline-secondary">4</button>
								<button class="btn btn-outline-secondary">5</button>
								<button class="btn btn-outline-secondary">6</button>
								<button class="btn btn-outline-secondary">7</button>
								<button class="btn btn-outline-secondary">8</button>
								<button class="btn btn-outline-secondary">9</button>
								<button class="btn btn-outline-secondary">.</button>
								<button class="btn btn-outline-secondary">0</button>
								<button class="btn btn-outline-danger">&lt;</button>
							</div>

							<!-- Pay Now button -->
							<button class="btn btn-success w-100 mb-2" id="calc" style="flex:0 0 45px;">Pay now</button>

							<!-- Transaction details -->
							<div id="trandet" class="border rounded p-2 small visually-hidden" style="flex:1;">
								<p class="fw-bold">Transaction Details</p>
								<hr class="my-1" />
								<div class="d-flex justify-content-between">
									<span>Amount received</span>
									<span id="receiptAmount"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>Subtotal</span>
									<span id="receiptSubtotal"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>VAT (12%)</span>
									<span id="receiptTax"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>Service Charge (10%)</span>
									<span id="receiptService"></span>
								</div>
								<div class="d-flex justify-content-between fw-bold">
									<span>Total</span>
									<span id="receiptTotal"></span>
								</div>
								<hr class="my-1" />
								<div class="d-flex justify-content-between fw-bold">
									<span>Change</span>
									<span id="receiptChange"></span>
								</div>
								<button class="btn btn-warning w-100 mt-2" id="printReceipt">Print receipt</button>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>
		$(document).ready(function () {
			window.addEventListener('afterprint', function() {
						window.location.reload()
			});
			$(".printwd").click(function (){
				let tableId = $(this).attr("id");
				let discountId = $("#select").val();
				let nump = $("#nump").val();
				let appl = $("#appl").val();
				if(discountId){
					$("#DiscountModal").modal("hide")
					fetch('/Cashier/ApplyDiscount', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams({
						tableid: tableId,
						discountid: discountId,
						num: nump,
						applic: appl
					})
				})
				.then(rawData => rawData.json())
				.then(m => {
					if (m.success) {
						let rows = $(`#Details${tableId} tbody tr`).map(function () {
						let cols = $(this).find("td");
						return `<tr>
									<td>${cols.eq(0).text()}</td>
									<td class="text-center">${cols.eq(1).text()}</td>
									<td class="text-end">${cols.eq(2).text()}</td>
								</tr>`;
					}).get().join("");

					// Build proper bill
					let content = `
						<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
							<h3>THE SOCIAL CEBU</h3>
							<p>Billing Statement</p>
							<p>Table: ${tableId}</p>
							<hr />
							<table style="width:100%; font-size:12px; text-align:left">
								<thead>
									<tr>
										<th style="text-align:left">Item</th>
										<th style="text-align:center">Qty</th>
										<th style="text-align:right">Price</th>
									</tr>
								</thead>
								<tbody>
									${rows}
								</tbody>
							</table>
							<hr />
							<div style="text-align:right">
								<p>Subtotal: ${m.bill.subtotal.toFixed(2)}</p>
								<hr/>

								<p>Service Charge: ${m.bill.servicecharge.toFixed(2)}</p>
								<p>${m.discount.discountName} discount: -${m.discount.amount.toFixed(2)}</p>
								<h5><strong>Total: ${m.breakdown.grandtotal.toFixed(2)}</strong></h5>
								<hr />
								<p>Vat Sales: ${m.breakdown.vatsales.toFixed(2)}</p>
								<p>Vat Exempt Sale: ${m.breakdown.vatexempt.toFixed(2)}</p>
								<p>Service Charge: ${m.bill.servicecharge.toFixed(2)}</p>
								<p>Total Sale: ${m.bill.totalsale.toFixed(2)}</p>
								<p>Vat Amount: ${m.bill.vatamount.toFixed(2)}</p>
								<p>Amount due : ${m.breakdown.grandtotal.toFixed(2)}</p>

							</div>
							<hr />


							<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
							<p>Thank you for dining with us!</p>
						</div>`
						$("#billbody").html(content);
						$("#BillModal").modal("show");
					}
					else{
						AlertModal("Error",m.message)
					}
				})
				}
				else{
					AlertModal("Error","Please select a discount to apply");
				}
			})

			$(".disc").click(function (){
				let id = $(this).attr("id");
				$(".printwd").attr("id",id)
				$("#select").val("")
			})

			$("#clear").click(function (){
				$("#amount").val("")
			})

			$("#calc").click(function (){
				let amount = parseFloat($("#amount").val());
				let tableId = $(this).attr("data-id");


				// let disc = $
				if (isNaN(amount) || amount <= 0) {
					AlertModal("Error","Please enter a valid amount");
					return;
				}

				fetch('/Cashier/PayBill', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams({
						tableid: tableId,
						amount: amount
					})
				})
				.then(rawData => rawData.json())
				.then(m => {
					if (m.success) {
						console.log(m)
						//add to transac details
						$("#receiptAmount").text("₱" + m.payment.amountPaid.toFixed(2));
						$("#receiptSubtotal").text("₱" + m.subtotal.toFixed(2));
						$("#receiptTax").text("₱" + m.tax.toFixed(2));
						$("#receiptService").text("₱" + m.servicecharge.toFixed(2));
						$("#receiptTotal").text("₱" + m.total.toFixed(2));
						$("#receiptChange").text("₱" + m.change.toFixed(2));


						let rows = $(`#Details${tableId} tbody tr`).map(function () {
						let cols = $(this).find("td");
						return `<tr>
									<td>${cols.eq(0).text()}</td>
									<td class="text-center">${cols.eq(1).text()}</td>
									<td class="text-end">${cols.eq(2).text()}</td>
								</tr>`;
						}).get().join("");

						// Build proper bill
						let content = `
							<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
								<h3>THE SOCIAL CEBU</h3>
								<p>Official Reciept</p>
								<p>Table: ${tableId}</p>
								<hr />
								<table style="width:100%; font-size:12px; text-align:left">
									<thead>
										<tr>
											<th style="text-align:left">Item</th>
											<th style="text-align:center">Qty</th>
											<th style="text-align:right">Price</th>
										</tr>
									</thead>
									<tbody>
										${rows}
									</tbody>
								</table>
								<hr />
								<div id="recadd" style="text-align:right">
									<p>Subtotal: ${m.subtotal.toFixed(2)}</p>
									<p>Vat Sales: ${m.vatSales.toFixed(2)}</p>
									<p>Vat Amount: ${m.tax.toFixed(2)}</p>
									<p>Service Charge: ${m.servicecharge.toFixed(2)}</p>

						`;
						if(m.discount != null){
							content += `<p>${m.discount.discountName} discount ${m.discount.percentage*100}%: - ${m.discount.amount.toFixed(2)}</p>
								<p><strong>Total: ${m.total.toFixed(2)}</strong></p>
								</div>
								<hr />
								<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
								<p>Thank you for dining with us!</p>
							</div>`
						}else{
							content += `									<p><strong>Total: ${m.total.toFixed(2)}</strong></p>
								</div>
								<hr />
								<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
								<p>Thank you for dining with us!</p>
							</div>`
						}
						$("#DisplayBody").html(content);

						$("#trandet").removeClass("visually-hidden");

						//add to reciept
						$("#recadd").append(`
							<hr />
							<p>Amount Received: ₱${m.payment.amountPaid.toFixed(2)}</p>
							<p><strong>Change: ₱${m.change.toFixed(2)}</strong></p>`
						)
					}
					else{
						AlertModal("Error",m.message);
					}
				});
			});

			$(document).on("click", "#printReceipt", function () {
				window.print()
			});
			

			$(".show").click(function () {
				let id = $(this).attr("id");
				$(".details").addClass("visually-hidden");
				$(`#Details${id}`).removeClass("visually-hidden");
			});


			// Generate Bill
			$(document).on("click", ".bill", function () {
				let tableId = $(this).attr("id");
				Billing(tableId)
			})

			function Billing(tableId, discountId = null) {
				fetch(`/Cashier/GenerateBill?tableid=${tableId}&discountid=${discountId}`)
				.then(res => res.json())
				.then(m => {
					if (m.success) {
						console.log(m)
						// Grab the details table for this table
						let rows = $(`#Details${tableId} tbody tr`).map(function () {
							let cols = $(this).find("td");
							return `<tr>
										<td>${cols.eq(0).text()}</td>
										<td class="text-center">${cols.eq(1).text()}</td>
										<td class="text-end">${cols.eq(2).text()}</td>
									</tr>`;
						}).get().join("");

						// Extract totals
						// Build proper bill
						let content = `
							<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
								<h3>THE SOCIAL CEBU</h3>
								<p>Billing Statement</p>
								<p>Table: ${tableId}</p>
								<hr />
								<table style="width:100%; font-size:12px; text-align:left">
									<thead>
										<tr>
											<th style="text-align:left">Item</th>
											<th style="text-align:center">Qty</th>
											<th style="text-align:right">Price</th>
										</tr>
									</thead>
									<tbody>
										${rows}
									</tbody>
								</table>
								<hr />
								<div style="text-align:right">
									<p>Subtotal: ${m.bill.subtotal.toFixed(2)}</p>
									<p>Vat Sales: ${m.bill.vatsales.toFixed(2)}</p>
									<p>Vat Amount: ${m.bill.vatamount.toFixed(2)}</p>
									<p>Service Charge: ${m.bill.servicecharge.toFixed(2)}</p>

						`;
						if(m.discount != null){
							content += `<p>Discount - ${m.discount.discountName} ${m.discount.percentage*100}%: ${m.discount.amount.toFixed(2)}</p>
								<p><strong>Total: ${m.bill.total.toFixed(2)}</strong></p>
								</div>
								<hr />
								<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
								<p>Thank you for dining with us!</p>
							</div>`
						}else{
							content += `									<p><strong>Total: ${m.bill.total.toFixed(2)}</strong></p>
								</div>
								<hr />
								<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
								<p>Thank you for dining with us!</p>
							</div>`
						}
						console.log(m)
						$("#billbody").html(content);
						$("#BillModal").modal("show");

					} else {
						AlertModal("Error",(m.detail || "Unable to generate bill."));
					}
				});
			};

			$('#PayModal').on('shown.bs.modal', function () {
				$("#amount").trigger('focus');
			});
			// Pay Bill
			$(document).on("click", ".pay", function () {
				let tableId = $(this).attr("id");
				fetch(`/Cashier/GetBill?tableid=${tableId}`)
				.then(res => res.json())
				.then(m => {
					if (!m.success) {
						AlertModal("Error",m.message || "Bill not found");
						return;
					}
					// Grab the details table for this table
						let rows = $(`#Details${tableId} tbody tr`).map(function () {
							let cols = $(this).find("td");
							return `<tr>
										<td>${cols.eq(0).text()}</td>
										<td class="text-center">${cols.eq(1).text()}</td>
										<td class="text-end">${cols.eq(2).text()}</td>
									</tr>`;
						}).get().join("");

						// Build proper bill
						let content = `
							<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
							<h3>THE SOCIAL CEBU</h3>
							<p>Billing Statement</p>
							<p>Table: ${tableId}</p>
							<hr />
							<table style="width:100%; font-size:12px; text-align:left">
								<thead>
									<tr>
										<th style="text-align:left">Item</th>
										<th style="text-align:center">Qty</th>
										<th style="text-align:right">Price</th>
									</tr>
								</thead>
								<tbody>
									${rows}
								</tbody>
							</table>
							<hr />
							<div style="text-align:right">
								<p>Subtotal: ${m.bill.subtotal.toFixed(2)}</p>
								<hr/>

								<p>Service Charge: ${m.bill.servicecharge.toFixed(2)}</p>
						`;
						if(m.discount != null){
							content += `<p>${m.discount.discountName} discount: -${m.discount.amount.toFixed(2)}</p>`
						}

						content += `
								<h5><strong>Total: ${m.breakdown.grandtotal.toFixed(2)}</strong></h5>
								<hr />
								<p>Vat Sales: ${m.breakdown.vatsales.toFixed(2)}</p>
								<p>Vat Exempt Sale: ${m.breakdown.vatexempt.toFixed(2)}</p>
								<p>Service Charge: ${m.bill.servicecharge.toFixed(2)}</p>
								<p>Total Sale: ${m.bill.totalsale.toFixed(2)}</p>
								<p>Vat Amount: ${m.bill.vatamount.toFixed(2)}</p>
								<p>Amount due : ${m.breakdown.grandtotal.toFixed(2)}</p>

							</div>
							<hr />


							<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
							<p>Thank you for dining with us!</p>
							</div>`;
					$("#DisplayBody").html(content);
					$("#PayModal").modal("show");
					$("#calc").removeAttr("data-id");
					$("#calc").attr("data-id",tableId);
					// // Update UI button
					// let btn = $(`#${tableId}.bill`);
					// btn.removeClass("bill").addClass("pay");
					// btn.text("Pay Bill");
					// btn.attr("data-bs-target", "#PayModal");


					// $("#PayModal").modal("hide");
					// // Remove the whole "Details" card

					// $(`#Details${id}`).fadeOut(300, function () {
					// 	$(this).remove();
					// });

					// // Also remove the "show" block on the left
					// $(`.show#${id}`).fadeOut(300, function () {
					// 	$(this).remove();
					// });

					// alert("Payment successful! Table is now available for orders.");
					// }
					// else {
					// 	alert("Error processing payment.");
					// }
					// });
				});
			});
			$(document).on("keydown input change", ".intonly", function(e) {
				// Block invalid keys on keydown
				console.log(e, ["e", "E", "+", "-", "."].includes(e.key))
				if (e.type === "keydown" && ["e", "E", "+", "-", "."].includes(e.key)) {
					e.preventDefault();
					return;
				}

				// Clean input on input/change
				let val = $(this).val().replace(/[^0-9]/g, "");
				// Prevent negative (just digits only)
				if (val === "") val = "";
				$(this).val(val);
			});

			const input = document.getElementById("amount");
			const keypad = document.getElementById("keypad");

			keypad.addEventListener("click", (e) => {
			  if (e.target.tagName !== "BUTTON") return; // only handle button clicks

			  const key = e.target.textContent.trim();

			  if (key === "<") {
				// backspace
				input.value = input.value.slice(0, -1);
			  } else if (key === ".") {
				// allow only one decimal
				if (!input.value.includes(".")) {
				  input.value = input.value === "" ? "0." : input.value + ".";
				}
			  } else {
				// digits
				if (input.value === "0" && key !== ".") {
				  input.value = key; // replace leading zero
				} else {
				  input.value += key;
				}
			  }
			});

		});
	</script>
}