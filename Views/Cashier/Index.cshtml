			// 							<hr />
			// 							<p>Amount Received: ${$("#receiptAmount").text()}</p>
			// 							<p>Change: ${$("#receiptChange").text()}</p>
			// 						</div>
			// 						<hr />
			// 						<p>Thank you! Please come again.</p>
			// 					</div>
