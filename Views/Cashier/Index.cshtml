				// });

				// alert("Payment successful! Table is now available for orders.");
				// }
				// else {
				// 	alert("Error processing payment.");
				// }
				// });
			});
			const input = document.getElementById("amount");
			const keypad = document.getElementById("keypad");

			keypad.addEventListener("click", (e) => {
			  if (e.target.tagName !== "BUTTON") return; // only handle button clicks

			  const key = e.target.textContent.trim();

			  if (key === "<") {
				// backspace
				input.value = input.value.slice(0, -1);
			  } else if (key === ".") {
				// allow only one decimal
				if (!input.value.includes(".")) {
				  input.value = input.value === "" ? "0." : input.value + ".";
				}
			  } else {
				// digits
				if (input.value === "0" && key !== ".") {
				  input.value = key; // replace leading zero
				} else {
				  input.value += key;
				}
			  }
			});

