@using TheSocialCebu_Capstone.Models
@using TheSocialCebu_Capstone.ViewModels
@{
	ViewData["Title"] = "Cashier";
}
@model List<BillingVM>

<style>
	@@media print {
  @@page {
    size: 80mm auto;   /* common thermal receipt width */
    margin: 5mm;       /* small margins */
  }

  body * {
    visibility: hidden;
  }

  #billbody, #billbody * {
    visibility: visible;
  }

  #billbody {
    position: absolute;
    left: 0;
    top: 0;
    width: 80mm;       /* match receipt width */
    height: auto;
    overflow: visible;
    font-family: monospace, sans-serif; /* receipt-like font */
    font-size: 12px;
  }

  /* remove scroll containers */
  #billbody .overflow-y-auto {
    overflow: visible !important;
    height: auto !important;
    max-height: none !important;
  }

  /* optional: remove borders/shadows for clean print */
  #billbody .border,
  #billbody .shadow,
  #billbody .rounded-3 {
    border: none !important;
    box-shadow: none !important;
  }
}
</style>
<div class="render-body">
	<div class="p-4">
		<div class="row">
			<div class="col-7 d-flex flex-column gap-2">
				@foreach (var t in Model.Where(x => x.Table.TableStatusId > 1)@* .Where(x => x.OrderItems.Count() > 0 && x.OrderItems.All(y => y.OrderItemStatusId > 2)) *@)
				{
					<div class="show focus-ring-success" id="@t.Table.TableId">
						<div class="border border-1 shadow rounded-3 p-2 hstack gap-3 me-2">
							<div class="p-2 px-3 bg-primary">
								<h3>@t.Table.TableNumber</h3>
							</div>
							<div class="d-flex flex-column justify-content-center">
								<p>@t.Table.TableId</p>
							</div>
						</div>
					</div>
				}
			</div>
			<div class="col-5">
				@foreach(var t in Model.Where(x => x.OrderItems != null))
				{
					<div class="border border-1 shadow rounded-3 p-3 details visually-hidden" id="@("Details" + t.Table.TableId)">
						<div>
							<div class="p-2 hstack gap-3 me-2">
								<div class="p-2 px-3 bg-primary">
									<h3>@t.Table.TableNumber</h3>
								</div>
								<div class="d-flex flex-column justify-content-center">
									<p class="m-0 fw-bold text-center">@t.Table.TableId</p>
								</div>
							</div>
							<div class="w-100 overflow-y-auto" style="min-height: 300px">
								<hr />
								<table class="w-100">
									<thead>
										<tr>
											<th>Items</th>
											<th>Qty</th>
											<th>Price</th>
										</tr>
									</thead>
									<tbody id="@("body" + t.Table.TableId)">
										@foreach (var item in t.OrderItems)
										{
											<tr>
												<td>@item.Prod.ProdName</td>
												<td>@item.Quantity</td>
												<td>₱@((item.Prod.Price * item.Quantity))</td>
											</tr>
										}
									</tbody>
								</table>
								<hr />
								<div class="vstack">
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat Sales</p>
										<p>₱@Convert.ToDecimal(t.Subtotal).ToString("0.00")</p>
									</div>
									@* <div class="d-flex justify-content-between align-items-center">
										<p>Discount</p>
									</div> *@
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat amount</p>
										<p>₱@Convert.ToDecimal(t.Tax).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Service Charge</p>
										<p>₱@Convert.ToDecimal(t.ServiceCharge).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Total</p>
										<p>₱@Convert.ToDecimal(t.Total).ToString("0.00")</p>
									</div>
									<div class="d-flex flex-row gap-2">
										@if (t.Table.TableStatusId == 3) 
										{
											<button class="btn btn-yellow bill flex-fill"
													data-bs-toggle="modal"
													data-bs-target="#BillModal"
													id="@t.Table.TableId">
												Generate Bill
											</button>
										}
										else if (t.Table.TableStatusId == 4) 
										{
											<button class="btn btn-yellow pay flex-fill"
													data-bs-toggle="modal"
													data-bs-target="#PayModal"
													id="@t.Table.TableId">
												Pay Bill
											</button>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="BillModal" tabindex="-1" aria-labelledby="BillModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-scrollable">
		<div class="modal-content border-secondary rounded">
			<div class="modal-body text-center" id="billbody">

			</div>
			<div class="w-100 d-flex flex-row gap-2 px-5 py-2">
				<button class="flex-fill btn btn-light shadow" data-bs-dismiss="modal" aria-label="Close">Back</button>
				<a class="flex-fill btn btn-yellow" href="javascript:window.print()">Print</a>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="PayModal" tabindex="-1" aria-labelledby="PayModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog">
		<div class="modal-content border-secondary rounded">
			<div class="modal-body">
				<div class="row">
					<div class="col-6" id="DisplayBody">

					</div>
					<div class="col-6">
						<div class="p-2">
							<input type="text" step="1" id="amount" class="w-100" placeholder="Place an amount"/>
							<div class="row" id="keypad">
								<div class="col-4 text-center">1</div>
								<div class="col-4 text-center">2</div>
								<div class="col-4 text-center">3</div>
								<div class="col-4 text-center">4</div>
								<div class="col-4 text-center">5</div>
								<div class="col-4 text-center">6</div>
								<div class="col-4 text-center">7</div>
								<div class="col-4 text-center">8</div>
								<div class="col-4 text-center">9</div>
								<div class="col-4 text-center">.</div>
								<div class="col-4 text-center">0</div>
								<div class="col-4 text-center">&lt;</div>
							</div>
							<button class="d-block mx-auto" id="calc">Pay now</button>
							<div class="p-2 visually-hidden" id="trandet">
								<p class="fw-bold">Transaction Details</p>
								<hr />
								<div class="d-flex justify-content-between">
									<p>Amount received</p>
									<p id="receiptAmount"></p>
								</div>
								<div class="d-flex justify-content-between">
									<p>Subtotal</p>
									<p id="receiptSubtotal"></p>
								</div>
								<div class="d-flex justify-content-between">
									<p>VAT (12%)</p>
									<p id="receiptTax"></p>
								</div>
								<div class="d-flex justify-content-between">
									<p>Service Charge (10%)</p>
									<p id="receiptService"></p>
								</div>
								<div class="d-flex justify-content-between fw-bold">
									<p>Total</p>
									<p id="receiptTotal"></p>
								</div>
								<hr />
								<div class="d-flex justify-content-between fw-bold">
									<p>Change</p>
									<p id="receiptChange"></p>
								</div>
								<button class="d-block mx-auto btn btn-yellow mt-2" id="printReceipt">Print receipt</button>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			$("#calc").click(function (){
				let amount = parseFloat($("#amount").val());
				let id = $(this).attr("data-id");

				if (isNaN(amount) || amount <= 0) {
					alert("Please enter a valid amount");
					return;
				}

				fetch(`/Cashier/CalculatePayment?tableid=${id}&amount=${amount}`)
				.then(rawData => rawData.json())
				.then(m => {
					if (m.message === "Success") {
						// Fill receipt details
						$("#receiptAmount").text("₱" + amount.toFixed(2));
						$("#receiptSubtotal").text("₱" + m.subtotal.toFixed(2));
						$("#receiptTax").text("₱" + m.tax.toFixed(2));
						$("#receiptService").text("₱" + m.servicecharge.toFixed(2));
						$("#receiptTotal").text("₱" + m.total.toFixed(2));
						$("#receiptChange").text("₱" + m.amount.toFixed(2));

						$("#trandet").removeClass("visually-hidden");
					}
				});
			});

			$(document).on("click", "#printReceipt", function () {
				let id = $("#calc").attr("data-id"); // table ID
				let amount = $("#receiptAmount").text();

				fetch(`/Cashier/PayBill?tableid=${id}&amount=${amount}`, { method: "POST" })
					.then(res => res.json())
					.then(m => {
						if (m.success) {
							// Build receipt
							let content = `
								<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
									<h3>RECEIPT</h3>
									<hr />
									<div style="text-align:left">
										${$("#DisplayBody").html()}
										<hr />
										<p>Subtotal: ${$("#receiptSubtotal").text()}</p>
										<p>VAT (12%): ${$("#receiptTax").text()}</p>
										<p>Service Charge: ${$("#receiptService").text()}</p>
										<p class="fw-bold">Total: ${$("#receiptTotal").text()}</p>
										<hr />
										<p>Amount Received: ${$("#receiptAmount").text()}</p>
										<p>Change: ${$("#receiptChange").text()}</p>
									</div>
									<hr />
									<p>Thank you! Please come again.</p>
								</div>
							`;

							$("#billbody").html(content);
							$("#BillModal").modal("show");

							setTimeout(() => {
								window.print();
								$("#BillModal").modal("hide");

								// Remove paid table from UI
								$("#" + id).remove();
								$("#Details" + id).remove();
							}, 300);
						} else {
							alert("Error: " + m.message);
						}
					});
			});

			$(".show").click(function () {
				let id = $(this).attr("id");
				$(".details").addClass("visually-hidden");
				$(`#Details${id}`).removeClass("visually-hidden");
			});


			// Generate Bill
			$(document).on("click", ".bill", function () {
				let tableId = $(this).attr("id");

				fetch(`/Cashier/GenerateBill?tableid=${tableId}`)
				.then(res => res.json())
				.then(m => {
					if (m.message === "Success") {

						// Grab the details table for this table
						let rows = $(`#Details${tableId} tbody tr`).map(function () {
							let cols = $(this).find("td");
							return `<tr>
										<td>${cols.eq(0).text()}</td>
										<td class="text-center">${cols.eq(1).text()}</td>
										<td class="text-end">${cols.eq(2).text()}</td>
									</tr>`;
						}).get().join("");

						// Extract totals
						let subtotal = $(`#Details${tableId}`).find("p:contains('Vat Sales')").next().text();
						let vat = $(`#Details${tableId}`).find("p:contains('Vat amount')").next().text();
						let service = $(`#Details${tableId}`).find("p:contains('Service Charge')").next().text();
						let total = $(`#Details${tableId}`).find("p:contains('Total')").next().text();

						// Build proper bill
						let content = `
							<div style="width:80mm; font-family:monospace; font-size:12px; text-align:center">
								<h3>THE SOCIAL CEBU</h3>
								<p>Billing Statement</p>
								<p>Table: ${tableId}</p>
								<hr />
								<table style="width:100%; font-size:12px; text-align:left">
									<thead>
										<tr>
											<th style="text-align:left">Item</th>
											<th style="text-align:center">Qty</th>
											<th style="text-align:right">Price</th>
										</tr>
									</thead>
									<tbody>
										${rows}
									</tbody>
								</table>
								<hr />
								<div style="text-align:right">
									<p>Vat Sales: ${subtotal}</p>
									<p>Vat Amount: ${vat}</p>
									<p>Service Charge: ${service}</p>
									<p><strong>Total: ${total}</strong></p>
								</div>
								<hr />
								<p style="font-size:11px">Generated: ${new Date().toLocaleString()}</p>
								<p>Thank you for dining with us!</p>
							</div>
						`;

						$("#billbody").html(content);
						$("#BillModal").modal("show");

						// Update UI button
						let btn = $(`#${tableId}.bill`);
						btn.removeClass("bill").addClass("pay");
						btn.text("Pay Bill");
						btn.attr("data-bs-target", "#PayModal");
					} else {
						alert("Error: " + (m.detail || "Unable to generate bill."));
					}
				});
			});


			// Pay Bill
			$(document).on("click", ".pay", function () {
				let id = $(this).attr("id");

				$.post("/Cashier/PayBill", { tableid: id }, function (m) {
					if (m.message === "Success") {
							$("#PayModal").modal("hide");
						// Remove the whole "Details" card

						$(`#Details${id}`).fadeOut(300, function () {
							$(this).remove();
						});

						// Also remove the "show" block on the left
						$(`.show#${id}`).fadeOut(300, function () {
							$(this).remove();
						});

						alert("✅ Payment successful! Table removed.");
					}
					else {
						alert("❌ Error processing payment.");
					}
				});
			});
			const input = document.getElementById("amount");
			const keypad = document.getElementById("keypad");

			keypad.addEventListener("click", (e) => {
				if (!e.target.classList.contains("text-center")) return;

				const key = e.target.textContent.trim();

				if (key === "<") {
				  // backspace
				  input.value = input.value.slice(0, -1);
				} else if (key === ".") {
				  // allow only one decimal
				  if (!input.value.includes(".")) {
					  if(input.value === "") {
						  input.value = "0.";
					  } else
						input.value += ".";
				  }
				} else {
				  // avoid leading zeros unless there's a decimal
				  if (input.value === "0" && key !== ".") {
					input.value = key;
				  } else {
					input.value += key;
				  }
				}
			})
		});
	</script>
}