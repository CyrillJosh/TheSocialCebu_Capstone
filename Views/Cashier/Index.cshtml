@using TheSocialCebu_Capstone.Models
@using TheSocialCebu_Capstone.ViewModels
@{
	ViewData["Title"] = "Cashier";
}
@model List<BillingVM>

<style>
	@@media print {
  @@page {
    size: 80mm auto;   /* common thermal receipt width */
    margin: 5mm;       /* small margins */
  }

  body * {
    visibility: hidden;
  }

  #billbody, #billbody * {
    visibility: visible;
  }

  #billbody {
    position: absolute;
    left: 0;
    top: 0;
    width: 80mm;       /* match receipt width */
    height: auto;
    overflow: visible;
    font-family: monospace, sans-serif; /* receipt-like font */
    font-size: 12px;
  }

  /* remove scroll containers */
  #billbody .overflow-y-auto {
    overflow: visible !important;
    height: auto !important;
    max-height: none !important;
  }

  /* optional: remove borders/shadows for clean print */
  #billbody .border,
  #billbody .shadow,
  #billbody .rounded-3 {
    border: none !important;
    box-shadow: none !important;
  }
}
</style>
<div class="render-body">
	<div class="p-4">
		<div class="row">
			<div class="col-7 d-flex flex-column gap-2">
				@foreach (var t in Model.Where(x => x.Table.TableStatusId > 1)@* .Where(x => x.OrderItems.Count() > 0 && x.OrderItems.All(y => y.OrderItemStatusId > 2)) *@)
				{
					<div class="show focus-ring-success" id="@t.Table.TableId">
						<div class="border border-1 shadow rounded-3 p-2 hstack gap-3 me-2">
							<div class="p-2 px-3 bg-primary">
								<h3>@t.Table.TableNumber</h3>
							</div>
							<div class="d-flex flex-column justify-content-center">
								<p>@t.Table.TableId</p>
							</div>
						</div>
					</div>
				}
			</div>
			<div class="col-5">
				@foreach(var t in Model.Where(x => x.OrderItems != null))
				{
					<div class="border border-1 shadow rounded-3 p-3 details visually-hidden" id="@("Details" + t.Table.TableId)">
						<div>
							<div class="p-2 hstack gap-3 me-2">
								<div class="p-2 px-3 bg-primary">
									<h3>@t.Table.TableNumber</h3>
								</div>
								<div class="d-flex flex-column justify-content-center">
									<p class="m-0 fw-bold text-center">@t.Table.TableId</p>
								</div>
							</div>
							<div class="w-100 overflow-y-auto" style="min-height: 300px">
								<hr />
								<table class="w-100">
									<thead>
										<tr>
											<th>Items</th>
											<th>Qty</th>
											<th>Price</th>
										</tr>
									</thead>
									<tbody id="@("body" + t.Table.TableId)">
										@foreach (var item in t.OrderItems)
										{
											<tr>
												<td>@item.Prod.ProdName</td>
												<td>@item.Quantity</td>
												<td>₱@((item.Prod.Price * item.Quantity))</td>
											</tr>
										}
									</tbody>
								</table>
								<hr />
								<div class="vstack">
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat Sales</p>
										<p>₱@Convert.ToDecimal(t.Subtotal).ToString("0.00")</p>
									</div>
									@* <div class="d-flex justify-content-between align-items-center">
										<p>Discount</p>
									</div> *@
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat amount</p>
										<p>₱@Convert.ToDecimal(t.Tax).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Service Charge</p>
										<p>₱@Convert.ToDecimal(t.ServiceCharge).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Total</p>
										<p>₱@Convert.ToDecimal(t.Total).ToString("0.00")</p>
									</div>
									<div class="d-flex flex-row gap-2">
										<button class="btn btn-yellow pay flex-fill" data-bs-toggle="modal" data-bs-target="#PayModal" id="@t.Table.TableId" @(t.Orders.All(x => x.OrderStatusId == 4) ? "" : "disabled")>Pay Bill</button>
										<button class="btn btn-yellow bill flex-fill" data-bs-toggle="modal" data-bs-target="#BillModal" id="@t.Table.TableId" @(t.Orders.All(x => x.OrderStatusId == 4) ? "" : "disabled")>Generate Bill</button>
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="BillModal" tabindex="-1" aria-labelledby="BillModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-scrollable">
		<div class="modal-content border-secondary rounded">
			<div class="modal-body text-center" id="billbody">

			</div>
			<div class="w-100 d-flex flex-row gap-2 px-5 py-2">
				<button class="flex-fill btn btn-light shadow" data-bs-dismiss="modal" aria-label="Close">Back</button>
				<a class="flex-fill btn btn-yellow" href="javascript:window.print()">Print</a>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="PayModal" tabindex="-1" aria-labelledby="PayModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog">
		<div class="modal-content border-secondary rounded">
			<div class="modal-body">
				<div class="row">
					<div class="col-6" id="DisplayBody">

					</div>
					<div class="col-6">
						<div class="p-2">
							<input type="text" step="1" id="amount" class="w-100" placeholder="Place an amount"/>
							<div class="row" id="keypad">
								<div class="col-4 text-center">1</div>
								<div class="col-4 text-center">2</div>
								<div class="col-4 text-center">3</div>
								<div class="col-4 text-center">4</div>
								<div class="col-4 text-center">5</div>
								<div class="col-4 text-center">6</div>
								<div class="col-4 text-center">7</div>
								<div class="col-4 text-center">8</div>
								<div class="col-4 text-center">9</div>
								<div class="col-4 text-center">.</div>
								<div class="col-4 text-center">0</div>
								<div class="col-4 text-center">&lt;</div>
							</div>
							<button class="d-block mx-auto" id="calc">Pay now</button>
							<div class="p-2 visually-hidden" id="trandet">
								<p>Transaction Details</p>
								<hr />
								<div class="d-flex justify-content-between">
									<p>Amount recieved</p>
									<p id="amount"></p>
								</div>
								<div class="d-flex justify-content-between">
									<p>Total</p>
									<p id="amount"></p>
								</div>
								<hr />
								<div class="d-flex justify-content-between">
									<p>Change</p>
									<p id="change"></p>
								</div>
								<button class="d-block mx-auto">Print reciept</button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(function () {
			$("#calc").click(function (){
				let amount = parseFloat($("#amount").val())
				let id = $(this).attr("data-id")
				fetch(`/Cashier/CalculatePayment?tableid=${id}&amount=${amount}`)
				.then(rawData => rawData.json())
				.then(m => {
					console.log(m)
				});
			});

			$(".show").click(function () {
				let id = $(this).attr("id");
				$(".details").addClass("visually-hidden");
				$(`#Details${id}`).removeClass("visually-hidden");
			});


			$(".pay").click(function (){
				let id = $(this).attr("id")
				$("#calc").attr("data-id", id);
				$("#trandet").addClass("visually-hidden")
				let content = $(`#Details${id}`).clone();
				content.find(".btn").remove();
				$("#DisplayBody").html(content);
				$("#amount").val("")

			})
				$(".bill").click(async function () {
		let id = $(this).attr("id");
		let content = $(`#Details${id}`).clone();

		// cleanup UI elements
		content.find(".btn").remove();
		content.find(".bg-primary").remove();

		try {
			let response = await fetch(`/Cashier/GenerateBill?tableid=${id}`);
			let m = await response.json();

			if (m.message === "Success") {
				$("#billbody").html(content);

				setTimeout(() => {
					window.print();
				}, 300);
			}
		} catch (err) {
			console.error("Error generating bill:", err);
		}
		});
			// $("#calc").click(function () {
			// 	let a = $("#amount").val();
			// 	if (a && parseFloat(a) > 0) {
			// 		$("#trandet").removeClass("visually-hidden");
			// 	} else {
			// 		alert("Please put an amount");
			// 	}
			// });
			const input = document.getElementById("amount");
			const keypad = document.getElementById("keypad");

			keypad.addEventListener("click", (e) => {
				if (!e.target.classList.contains("text-center")) return;

				const key = e.target.textContent.trim();

				if (key === "<") {
				  // backspace
				  input.value = input.value.slice(0, -1);
				} else if (key === ".") {
				  // allow only one decimal
				  if (!input.value.includes(".")) {
					  if(input.value === "") {
						  input.value = "0.";
					  } else
						input.value += ".";
				  }
				} else {
				  // avoid leading zeros unless there's a decimal
				  if (input.value === "0" && key !== ".") {
					input.value = key;
				  } else {
					input.value += key;
				  }
				}
			})

		});
	</script>
}