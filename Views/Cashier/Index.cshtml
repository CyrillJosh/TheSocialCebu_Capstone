				// // Update UI button
				// let btn = $(`#${tableId}.bill`);
				// btn.removeClass("bill").addClass("pay");
				// btn.text("Pay Bill");
				// btn.attr("data-bs-target", "#PayModal");


				// $("#PayModal").modal("hide");
				// // Remove the whole "Details" card

				// $(`#Details${id}`).fadeOut(300, function () {
