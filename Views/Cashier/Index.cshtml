@using TheSocialCebu_Capstone.Models
@using TheSocialCebu_Capstone.ViewModels
@{
	ViewData["Title"] = "Cashier";
}
@model List<BillingVM>

<style>
	@@media print {
    @@page {
        size: 80mm auto !important;   /* thermal receipt width */
        margin: 5mm !important;
    }

    body * {
        visibility: hidden;
    }
		/* Show only receipt areas */
		#billbody, #billbody *,
		#DisplayBody, #DisplayBody * {
			visibility: visible;
		}
		/* Position and style both */
		#billbody, #DisplayBody {
			position: absolute;
			top: 0;
			left: 0;
			width: 80mm;
			font-family: monospace, sans-serif;
			font-size: 12px;
			line-height: 1.4;
			color: #000;
			padding: 5px;
		}
		/* Reset modal/frame styling */
		.modal,
		.modal-dialog,
		.modal-content,
		.modal-body {
			all: unset !important;
		}
		/* Table styling */
		#billbody table,
		#DisplayBody table {
			width: 100%;
			border-collapse: collapse;
		}

		#billbody th, #billbody td,
		#DisplayBody th, #DisplayBody td {
			padding: 2px 0;
		}

		#billbody th, #DisplayBody th {
			font-weight: bold;
		}
		/* Receipt text align helpers */
		.text-center {
			text-align: center !important;
		}

		.text-end {
			text-align: right !important;
		}

		.text-left {
			text-align: left !important;
		}
}
</style>
<div class="render-body">
	<div class="p-4">
		<div class="row">
			<div class="col-7 d-flex flex-column gap-2">
				@foreach (var t in Model.Where(x => x.Table.TableStatusId > 1)@* .Where(x => x.OrderItems.Count() > 0 && x.OrderItems.All(y => y.OrderItemStatusId > 2)) *@)
				{
					<div class="show focus-ring-success" id="@t.Table.TableId">
						<div class="border border-1 shadow rounded-3 p-2 hstack gap-3 me-2">
							<div class="p-2 px-3 bg-primary">
								<h3>@t.Table.TableNumber</h3>
							</div>
							<div class="d-flex flex-column justify-content-center">
								<p>@t.Table.TableId</p>
							</div>
						</div>
					</div>
				}
			</div>
			<div class="col-5">
				@foreach(var t in Model.Where(x => x.OrderItems != null))
				{
					<div class="border border-1 shadow rounded-3 p-3 details visually-hidden" id="@("Details" + t.Table.TableId)">
						<div>
							<div class="p-2 hstack gap-3 me-2">
								<div class="p-2 px-3 bg-primary">
									<h3>@t.Table.TableNumber</h3>
								</div>
								<div class="d-flex flex-column justify-content-center">
									<p class="m-0 fw-bold text-center">@t.Table.TableId</p>
								</div>
							</div>
							<div class="w-100 overflow-y-auto" style="min-height: 300px">
								<hr />
								<table class="w-100">
									<thead>
										<tr>
											<th>Items</th>
											<th>Qty</th>
											<th>Price</th>
										</tr>
									</thead>
									<tbody id="@("body" + t.Table.TableId)">
										@foreach (var item in t.OrderItems)
										{
											<tr>
												<td>@item.Prod.ProdName</td>
												<td>@item.Quantity</td>
												<td>₱@((item.Prod.Price * item.Quantity))</td>
											</tr>
										}
									</tbody>
								</table>
								<hr />
								<div class="vstack">
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat Sales</p>
										<p>₱@Convert.ToDecimal(t.Subtotal).ToString("0.00")</p>
									</div>
									@* <div class="d-flex justify-content-between align-items-center">
										<p>Discount</p>
									</div> *@
									<div class="d-flex justify-content-between align-items-center">
										<p>Vat amount</p>
										<p>₱@Convert.ToDecimal(t.Tax).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Service Charge</p>
										<p>₱@Convert.ToDecimal(t.ServiceCharge).ToString("0.00")</p>
									</div>
									<div class="d-flex justify-content-between align-items-center">
										<p>Total</p>
										<p>₱@Convert.ToDecimal(t.Total).ToString("0.00")</p>
									</div>
									<div class="d-flex flex-row gap-2">
										@if (t.Table.TableStatusId == 3) 
										{
											<button class="btn btn-yellow bill flex-fill"
													id="@t.Table.TableId">
												Generate Bill
											</button>
										}
										else if (t.Table.TableStatusId == 4) 
										{
											<button class="btn btn-yellow pay flex-fill"
													id="@t.Table.TableId">
												Pay Bill
											</button>
										}
									</div>
								</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>
<div class="modal fade" id="BillModal" tabindex="-1" aria-labelledby="BillModal" aria-hidden="true">
	<div class="modal-dialog modal-dialog-scrollable">
		<div class="modal-content border-secondary rounded">
			<div class="flex-grow-1 p-2 d-flex justify-content-center overflow-y-auto" id="billbody">

			</div>
			<div class="w-100 d-flex flex-row gap-2 px-5 py-2">
				<button class="flex-fill btn btn-light shadow" data-bs-dismiss="modal" aria-label="Close">Back</button>
				<a class="flex-fill btn btn-yellow" href="javascript:window.print()">Print</a>
			</div>
		</div>
	</div>
</div>

<div class="modal fade" id="PayModal" tabindex="-1" aria-labelledby="PayModal" aria-hidden="true">
	<div class="modal-dialog modal-xl modal-dialog-centered">
		<div class="modal-content border-secondary rounded" style="height: 100vh;">
			<div class="modal-body h-100">
				<div class="row h-100">

					<!-- Left side (bill/receipt preview) -->
					<div class="col-6 h-100 d-flex flex-column">
						<div id="DisplayBody" class="flex-grow-1 p-2 d-flex justify-content-center overflow-y-auto">
							<!-- Receipt content will be injected here -->
						</div>
					</div>

					<!-- Right side -->
					<div class="col-6 h-100 d-flex flex-column border-start">
						<div class="p-2 h-100">

							<!-- Input -->
							<input type="text" id="amount"
								   class="form-control mb-2"
								   placeholder="Place an amount"
								   style="flex:0 0 40px; height: 5%" />

							<!-- Keypad (3×4 grid) -->
							<div id="keypad" class="d-grid mb-2 gap-1"
								 style="grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); flex:1; height: 30%">
								<button class="btn btn-outline-secondary">1</button>
								<button class="btn btn-outline-secondary">2</button>
								<button class="btn btn-outline-secondary">3</button>
								<button class="btn btn-outline-secondary">4</button>
								<button class="btn btn-outline-secondary">5</button>
								<button class="btn btn-outline-secondary">6</button>
								<button class="btn btn-outline-secondary">7</button>
								<button class="btn btn-outline-secondary">8</button>
								<button class="btn btn-outline-secondary">9</button>
								<button class="btn btn-outline-secondary">.</button>
								<button class="btn btn-outline-secondary">0</button>
								<button class="btn btn-outline-danger">&lt;</button>
							</div>

							<!-- Pay Now button -->
							<button class="btn btn-success w-100 mb-2" id="calc" style="flex:0 0 45px;">Pay now</button>

							<!-- Transaction details -->
							<div id="trandet" class="border rounded p-2 small visually-hidden" style="flex:1;">
								<p class="fw-bold">Transaction Details</p>
								<hr class="my-1" />
								<div class="d-flex justify-content-between">
									<span>Amount received</span>
									<span id="receiptAmount"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>Subtotal</span>
									<span id="receiptSubtotal"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>VAT (12%)</span>
									<span id="receiptTax"></span>
								</div>
								<div class="d-flex justify-content-between">
									<span>Service Charge (10%)</span>
									<span id="receiptService"></span>
								</div>
								<div class="d-flex justify-content-between fw-bold">
									<span>Total</span>
									<span id="receiptTotal"></span>
								</div>
								<hr class="my-1" />
								<div class="d-flex justify-content-between fw-bold">
									<span>Change</span>
									<span id="receiptChange"></span>
								</div>
								<button class="btn btn-warning w-100 mt-2" id="printReceipt">Print receipt</button>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts {
	<script>
		$(document).ready(function () {
			$("#calc").click(function (){
				let amount = parseFloat($("#amount").val());
				let id = $(this).attr("data-id");

				if (isNaN(amount) || amount <= 0) {
					alert("Please enter a valid amount");
					return;
				}

				fetch('/Cashier/PayBill', {
					method: 'POST',
					headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
					body: new URLSearchParams({
						tableid: id,
						amount: amount
					})
				})
				.then(rawData => rawData.json())
				.then(m => {
					if (m.success) {
						//add to transac details
						$("#receiptAmount").text("₱" + m.payment.amountPaid.toFixed(2));
						$("#receiptSubtotal").text("₱" + m.subtotal.toFixed(2));
						$("#receiptTax").text("₱" + m.tax.toFixed(2));
						$("#receiptService").text("₱" + m.servicecharge.toFixed(2));
						$("#receiptTotal").text("₱" + m.total.toFixed(2));
						$("#receiptChange").text("₱" + m.change.toFixed(2));
						$("#trandet").removeClass("visually-hidden");

						//add to reciept
						$("#recadd").append(`
							<hr />
							<p>Amount Received: ₱${m.payment.amountPaid.toFixed(2)}</p>
							<p><strong>Change: ₱${m.change.toFixed(2)}</strong></p>`
						)
					}
					else{
						alert("Error: " + m.message);
					}
				});
			});

			$(document).on("click", "#printReceipt", function () {
				window.print()
			});
