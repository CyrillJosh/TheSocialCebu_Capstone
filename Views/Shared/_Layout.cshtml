<!DOCTYPE html>
<html lang="en" id="htmlPage" data-bs-theme="light" class="overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheSocialCebu_Capstone</title>
    <link rel="stylesheet" href="~/css/datatable.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/TheSocialCebu_Capstone.styles.css" asp-append-version="true" />
	<script>
		(function() {
		  const savedTheme = localStorage.getItem("theme") || "light";
		  document.documentElement.setAttribute("data-bs-theme", savedTheme);
		})();
	</script>
	<style>
		.btn:focus {
			box-shadow: none !important;
		}

		#food-search:focus {
			outline: none;
			box-shadow: none;
		}

		#navigation .btn:hover img, #settings label:hover img, #settings .btn:hover img {
			filter: invert(1) brightness(0) !important;
		}
		#settings label:hover, #settings .btn:hover {
			color: #000;
			background: #fcef00;
			border-color: #D6CB00;
		}
	</style>
    @await RenderSectionAsync("Links", required: false)
</head>
<body class="row row-cols-sm-1 row-cols-lg-2 vh-100 vw-100 text-black" style="margin-left:0 !important">
	@{
		var userId = Context.Session.GetString("_Id");
		var userRole = Context.Session.GetString("_Role");
		// var userId = "1";
		// var userRole = "Admin";

		var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
		var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	}
	@if (userId != null && userRole != null && !(currentController == "Home" || currentController == "Order" || (currentController == "User" && currentAction == "Login")))
	{
		<div class="bg-gray d-none d-sm-flex flex-column p-2 vh-100 position-fixed start-0 top-0 " style="width: 250px; z-index: 9999">
			<div class="navbar-brand font-monospace fw-bold d-flex align-items-center justify-content-center gap-2 mb-1 text-white text-decoration-none">
				<img class="logo" src="/images/The Social Logo.png" height="50" />
				<h2 class="m-0 text-antonio fw-bold" style="letter-spacing: 2px">THE SOCIAL</h2>
			</div>
			<div class="offcanvas-body flex-grow-1 d-flex flex-column gap-1 mt-1" id="navigation">
				@if (userRole == "Manager")
				{
					<a class="btn @(currentController == "Menu" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Menu" asp-action="Index">
						<img src="~/Images/digitalmenu.png" alt="Digital Menu" height="50" width="50"
							 style="filter: invert(@(currentController == "Menu" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">MENU MANAGEMENT</h6>
					</a>

					<a class="btn @(currentController == "Table" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Table" asp-action="Index">
						<img src="~/Images/table.png" alt="Table Management" height="50" width="50"
							 style="filter: invert(@(currentController == "Table" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">TABLE MANAGEMENT</h6>
					</a>

					<a class="btn @(currentController == "Cashier" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Cashier" asp-action="Index">
						<img src="~/Images/bill.png" alt="Billing Management" height="50" width="50"
							 style="filter: invert(@(currentController == "Cashier" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">BILLING MANAGEMENT</h6>
					</a>

					<a class="btn @(currentController == "Kitchen" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Kitchen" asp-action="Index">
						<img src="~/Images/order manage.png" alt="Order Management" height="50" width="50"
							 style="filter: invert(@(currentController == "Kitchen" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">ORDER MANAGEMENT</h6>
					</a>

					<a class="btn @(currentController == "User" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="User" asp-action="HomePage">
						<img src="~/Images/employee.png" alt="Employee Management" height="50" width="50"
							 style="filter: invert(@(currentController == "User" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">EMPLOYEE MANAGEMENT</h6>
					</a>

					<a class="btn @(currentController == "Marketing" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Marketing" asp-action="Index">
						<img src="~/Images/feedback.png" alt="Feedback Management" height="50" width="50"
							 style="filter: invert(@(currentController == "Marketing" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">FEEDBACK MANAGEMENT</h6>
					</a>
				}
				else if (userRole == "Kitchen")
				{
					<a class="btn @(currentAction == "Menu" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Kitchen" asp-action="Menu">
						<img src="~/Images/digitalmenu.png" alt="Digital Menu" height="50" width="50"
							 style="filter: invert(@(currentAction == "Menu" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">DIGITAL MENU</h6>
					</a>

					<a class="btn @(currentAction == "Index" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Kitchen" asp-action="Index">
						<img src="~/Images/order.png" alt="Order Management" height="50" width="50"
							 style="filter: invert(@(currentAction == "Index" ? 1 : 0)) saturate(0); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">ORDER MANAGEMENT</h6>
					</a>

					<a class="btn @(currentAction == "Orders" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Kitchen" asp-action="Orders">
						<img src="~/Images/Orders.png" alt="Completed Orders" height="50" width="50"
						 style="filter: invert(@(currentAction == "Orders" ? 1 : 0)) saturate(0); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">COMPLETED ORDERS</h6>
					</a>
				}
				else if (userRole == "Cashier")
				{
					<a class="btn @(currentAction == "Index" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Cashier" asp-action="Index">
						<img src="~/Images/bill.png" alt="Billing Management" height="50" width="50"
							 style="filter: invert(@(currentAction == "Index" ? 1 : 0)); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">BILLING MANAGEMENT</h6>
					</a>

					<a class="btn @(currentAction == "CompletedBills" ? "btn-primary" : "btn-dark") pt-1 w-100 text-center d-flex flex-column align-items-center"
					   asp-controller="Cashier" asp-action="CompletedBills">
						<img src="~/Images/Orders.png" alt="Completed Bills" height="50" width="50"
							 style="filter: invert(@(currentAction == "CompletedBills" ? 1 : 0)) saturate(0); transition: filter 0.3s ease;" />
						<h6 class="text-poppins fw-semibold text-nowrap">COMPLETED BILLS</h6>
					</a>
				}



				@* <a href="http://localhost:5021/Order/Table/cd69e8bc-ee35-4132-9768-8d4e198f9b8f">Order shortcut</a>
			<a href="http://localhost:5021/Kitchen">Kitchen shortcut</a>
			<a href="http://localhost:5021/Cashier">Cashier shortcut</a>
			*@
				<a class="btn @(currentAction == "Account" ? "btn-primary" : "btn-dark") w-100 d-flex flex-row align-items-center gap-2 mt-auto" asp-controller="User" asp-action="Account" asp-route-id="@userId">
					<img src="~/Images/settings.png" alt="Account" height="25" width="25"
							style="filter: invert(@(currentAction == "Account" ? 1 : 0)); transition: filter 0.3s ease;" />
					<p class="m-0 p-0">Account</p>
				</a>
				<div class="d-flex flex-row gap-1" id="settings">
					<label for="theme" class="btn btn-dark flex-grow-1 d-flex flex-row gap-2 align-items-center text-start">
						<input type="checkbox" id="theme" hidden />
						<img src="~/Images/theme.png" alt="Account" height="20" width="20"/>
						<span class="m-0 p-0">Theme</span>
					</label>

					@if (userId != null && userRole != null)
					{
						<a class="btn btn-dark flex-grow-1 text-start d-flex flex-row align-items-center gap-2" asp-controller="User" asp-action="Logout">
							<img src="~/Images/logout.png" alt="Account" height="20" width="20" />
							<p class="m-0 p-0">Logout</p>
						</a>
					}
					else
					{
						<a class="btn btn-dark flex-grow-1 text-start" asp-controller="User" asp-action="Login">Login</a>
					}
				</div>
			</div>
		</div>
	}
    <div class="flex-grow-1 col pe-0 ps-0 position-relative">
        @RenderBody()
    </div>

	<div class="modal fade" id="AlertModal" aria-labeledby="AlertModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h6 class="modal-title" id="AlertTitle"></h6>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body" id="Alertmessage">
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
				</div>
			</div>
		</div>
	</div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/datatable.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/signalR.js"></script>

	<script>
		function AlertModal(title,message){
			$("#AlertTitle").text("");
			$("#AlertTitle").text(title);
			$("#Alertmessage").text("");
			$("#Alertmessage").text(message);
			$("#AlertModal").modal("show");
		}
	</script>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const html = document.documentElement;
			const themeBtn = document.getElementById("theme");

			themeBtn.addEventListener("click", function () {
				const currentTheme = html.getAttribute("data-bs-theme");
				const newTheme = currentTheme === "dark" ? "light" : "dark";
				html.setAttribute("data-bs-theme", newTheme);
				localStorage.setItem("theme", newTheme);
			});

		});
		window.connection = new signalR.HubConnectionBuilder()
			.withUrl("/connectorHub")
			.withAutomaticReconnect()
			.build();

		// Start the connection once
		window.connection.start()
			.then(() => console.log("SignalR connected"))
			.catch(err => console.error("SignalR connection error:", err));
	</script>
    @await RenderSectionAsync("Scripts", required: false)
	

</body>
</html>
