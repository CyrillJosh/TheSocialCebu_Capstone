<!DOCTYPE html>
<html lang="en" id="htmlPage" data-bs-theme="light" class="overflow-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TheSocialCebu_Capstone</title>
    <link rel="stylesheet" href="~/css/datatable.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/TheSocialCebu_Capstone.styles.css" asp-append-version="true" />
	<script>
		(function() {
		  const savedTheme = localStorage.getItem("theme") || "light";
		  document.documentElement.setAttribute("data-bs-theme", savedTheme);
		})();
	</script>
	<style>
		.btn:focus {
			box-shadow: none !important;
		}
	</style>
    @await RenderSectionAsync("Links", required: false)
</head>
<body class="row row-cols-sm-1 row-cols-lg-2 vh-100 vw-100 text-black" style="margin-left:0 !important">
	@{
		// var userId = Context.Session.GetString("_Id");
		// var userRole = Context.Session.GetString("_Role");
		var userId = "1";
		var userRole = "Admin";

		var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
		var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
	}
	@if(userId != null && userRole != null)
	{
		<div class="bg-gray d-none d-sm-flex flex-column py-3 vh-100 position-fixed start-0 top-0 z-3 px-4" style="width: 250px;">
			<div class="navbar-brand font-monospace fw-bold d-flex align-items-center gap-2 text-white text-decoration-none">
				<img class="logo" src="/images/The Social Logo.png" height="50" />
				<h4 class="m-0">THE SOCIAL</h4>
			</div>
			<div class="offcanvas-body d-flex flex-column gap-2 mt-5" id="navigation">
				@if (userRole == "Admin")
				{
					<a class="btn @(currentController == "Menu" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Menu" asp-action="Index">Menu Management</a>
					<a class="btn @(currentController == "Table" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Table" asp-action="Index">Table Management</a>
					<a class="btn @(currentController == "Cashier" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Cashier" asp-action="Index">Billing Management</a>
					<a class="btn @(currentController == "Kitchen" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Kitchen" asp-action="Index">Order Management</a>
					<a class="btn @(currentController == "User" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="User" asp-action="Index">Employee Management</a>
				}
				else if (userRole == "Kitchen")
				{
					<a class="btn @(currentAction == "Index" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Kitchen" asp-action="Index">Order Management</a>
					<a class="btn @(currentAction == "Menu" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Kitchen" asp-action="Menu">Menu Management</a>
				}
				else if (userRole == "Cashier")
				{
					<a class="btn @(currentAction == "Index" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Cashier" asp-action="Index">Billing Management</a>
					<a class="btn @(currentAction == "CompletedBills" ? "btn-primary" : "btn-dark") w-100 text-start" asp-controller="Casheir" asp-action="CompletedBills">Completed bills</a>
				}


				@* <a href="http://localhost:5021/Order/Table/cd69e8bc-ee35-4132-9768-8d4e198f9b8f">Order shortcut</a>
			<a href="http://localhost:5021/Kitchen">Kitchen shortcut</a>
			<a href="http://localhost:5021/Cashier">Cashier shortcut</a>
			*@
				<label for="theme" class="btn btn-dark w-100 text-start mt-auto">
					<input type="checkbox" id="theme" hidden /> Theme
				</label>

				@if (userId != null && userRole != null)
				{
					<a class="btn btn-dark w-100 text-start">Logout</a>
				}
				else
				{
					<a class="btn btn-dark w-100 text-start" asp-controller="User" asp-action="Login">Login</a>
				}
			</div>
		</div>
	}
    <div class="flex-grow-1 col pe-0 ps-0 position-relative">
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/datatable.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/signalR.js"></script>

	<script>
		document.addEventListener("DOMContentLoaded", function () {
			const html = document.documentElement;
			const themeBtn = document.getElementById("theme");

			themeBtn.addEventListener("click", function () {
				const currentTheme = html.getAttribute("data-bs-theme");
				const newTheme = currentTheme === "dark" ? "light" : "dark";
				html.setAttribute("data-bs-theme", newTheme);
				localStorage.setItem("theme", newTheme);
			});

			window.connection = new signalR.HubConnectionBuilder()
				.withUrl("/connectorHub")
				.withAutomaticReconnect()
				.build();

			// Start the connection once
			window.connection.start()
				.then(() => console.log("SignalR connected"))
				.catch(err => console.error("SignalR connection error:", err));
		});
	</script>
    @await RenderSectionAsync("Scripts", required: false)
	

</body>
</html>
