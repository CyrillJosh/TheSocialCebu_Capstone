@{
    ViewData["Title"] = "Error";
}
@model string
@{
    var arr = Model?.Split('|');
    string title = arr != null && arr.Length > 0 ? arr[0] : "Error";
    string message = arr != null && arr.Length > 1 ? arr[1] : "An error occurred while processing your request.";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    if(currentController == "Home" || currentController == "Order")
    {
        message += " Please scan again. Thank you.";
    }
}
<div class="render-body vh-100 vw-100 d-flex justify-content-center align-items-center">
    <div class="d-flex flex-column text-center justify-content-center align-items-center gap-3">
        <img src="~/Images/The Social Logo.png" alt="The Social Cebu Logo" style="width: 25% !important ;min-width: 150px; max-width: 400px"/>
        <h1 class="text-dark" style="font-size: 7vw">
            @title
        </h1>
        <h5 class="text-dark text-wrap px-3" style="font-size: 5vw">
            @message
        </h5>
        <a onclick="history.back()" class="bg-primary text-decoration-none text-black rounded-pill px-5 py-2" >Go Back</a>
    </div>
</div>
