@using TheSocialCebu_Capstone.Models
@{
	ViewData["Title"] = "Kitchen - Orders";
}
@model List<Order>
<div class="render-body vh-100 w-100 text-dark">
	<div class="p-4 h-100 w-100">
		<div class="row h-100 w-100">
			<div class="col-sm-12 col-md-8 col-lg-8 h-100 d-flex flex-column">
				<h1 class="text-antonio fw-bold" style="letter-spacing: 2px">ORDERS</h1>
				<div class="w-100 mt-3 flex-grow-1 overflow-y-auto">
					<div class="d-flex gap-1 flex-wrap mt-4" id="orderNums" @* style="min-height: 30vh;max-height: 81vh" *@>
						@foreach (var order in Model)
						{
							<button class="col-3 border border-1 rounded-3 bg-body-secondary p-2 hstack gap-3 me-1 mb-1 Order" id="@order.OrderId">
								<div class="p-2 @(order.Table.LocationId == 2 ? "bg-success" :
												order.Table.LocationId == 1 ? "bg-danger" :
												order.Table.LocationId == 4 ? "bg-warning" : "bg-info") text-black rounded-3 d-flex justify-content-center align-items-center" style="min-height: 50px; min-width:50px">
									<h3 class="m-0 p-0 fw-bold">@order.Table.TableNumber</h3>
								</div>
								<div class="d-flex flex-column justify-content-center text-start">
									<p class="m-0 fw-bold">Order #: @order.OrderNumber.ToString("00000")</p>
									<p class="m-0">@Convert.ToDateTime(order.CreatedAt).ToString("t").ToUpper()</p>
								</div>
							</button>
						}
					</div>
				</div>
			</div>
			<div class="col-md-4 col-sm-12 col-lg-4 h-100 border-start d-flex flex-column">
				<h1 class="text-antonio fw-bold" style="letter-spacing: 2px">ORDER DETAILS</h1>
				<p>Select an order to view details</p>
				<div id="OrderDetails" class="flex-grow-1 overflow-y-auto">
					@foreach (var order in Model)
					{
						<div class="border border-1 rounded-3 p-3 w-100 visually-hidden OrderDetails bg-body-secondary" id="@order.OrderId">
							<div>
								<div class="p-2 hstack gap-3 me-2">
									<div class="p-2 @(order.Table.LocationId == 2 ? "bg-success" :
													order.Table.LocationId == 1 ? "bg-danger" :
													order.Table.LocationId == 4 ? "bg-warning" : "bg-info") text-black rounded-4 d-flex justify-content-center align-items-center" style="min-height: 50px; min-width:50px">
										<h3 class="m-0 p-0 fw-bold">@order.Table.TableNumber</h3>
									</div>
									<div class="d-flex flex-column justify-content-center text-start">
										<p class="m-0 fw-bold">Order #: @order.OrderNumber.ToString("00000")</p>
										<p class="m-0">@Convert.ToDateTime(order.CreatedAt).ToString("t").ToUpper()</p>
									</div>
								</div>
								<div class="w-100 overflow-y-auto" style="min-height: 300px">
									<table class="w-100">
										<thead>
											<tr>
												<th></th>
												<th></th>
												<th></th>
											</tr>
										</thead>
										<tbody id="@("body" + order.OrderId)">
											@foreach (var subcat in order.OrderItems.Select(x => x.Prod.Subcategory).Distinct())
											{
												<tr>
													<td colspan="3">
														<div>
															<hr />
															<p>@subcat.SubcategoryName</p>
														</div>
													</td>
												</tr>
												@foreach (var item in order.OrderItems.Where(x => x.Prod.SubcategoryId == subcat.SubcategoryId))
												{
													<tr id="@item.OrderItemId">
															<td colspan="2">
																<div>
																	<h5>@item.Prod.ProdName</h5>
																	<p class="fst-italic">@(string.IsNullOrEmpty(item.Instructions) ? "" : "Instructions: " + item.Instructions)</p>
																</div>
															</td>
															<td>
																<p id="qty" class="m-0">@item.Quantity</p>
															</td>
													</tr>
												}
											}
										</tbody>
									</table>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		$(document).ready(async function () {
			$(".Order").click(function () {
				const orderId = $(this).attr("id");
				$(".OrderDetails").addClass("visually-hidden");
				$(`#OrderDetails #${orderId}`).removeClass("visually-hidden");
			});
		})
	</script>
}
