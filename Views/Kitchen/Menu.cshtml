@using TheSocialCebu_Capstone.Models
@model List<Product> 
@{
    ViewData["Title"] = "Product List";
}

<div class="render-body vh-100 vw-100">
    <div class="h-100 w-100 p-4 d-flex flex-column">
        <div class="d-flex justify-content-evenly align-items-center mb-4">
            <h1 class="text-dark fw-bold text-antonio">PRODUCTS</h1>
            <div class="row h-50 input-group gap-2 m-2 d-flex justify-content-end">
                <div class="border border-2 rounded-pill text-dark border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    <input id="custom-search-input" type="text" placeholder="Search" class="border-0 focus-none bg-transparent m-0 p-0" />
                </div>
            </div>
        </div>

        <div class="flex-grow-1 overflow-auto table-responsive">
            <table id="Table" class="table table-hover align-middle rounded table-separate ">
                <thead class="sticky-top">
                    <tr>
                        <th class="col">Name</th>
                        <th class="col">Category</th>
                        <th class="col">Subcategory</th>
                        <th class="col text-center">Availability</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary text-amarath">@item.ProdName.ToUpper()</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@item.Subcategory.Category.CategoryName.ToUpper()</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@item.Subcategory.SubcategoryName.ToUpper()</td>
                            <td class="border-2 border-start-0 border-secondary bg-body-secondary rounded-end d-flex justify-content-center">
                               @*  <div class="form-check form-switch">
                                    <input class="form-check-input change p-0 m-0" type="checkbox" id="@item.ProdId" @(item.Availability ? "checked" : "")>
                                </div> *@
                                @* <div class="btn-group rounded rounded-pill" role="group" aria-label="Status">
                                    <input type="radio"
                                           class="btn-check change-status"
                                           name="StatusId-@item.ProdId"
                                           id="available-@item.ProdId"
                                           data-prodid="@item.ProdId"
                                           autocomplete="off"
                                           @(item.Availability ? "checked" : "")>
                                    <label class="btn btn-outline-success rounded-start-5" for="available-@item.ProdId">Available</label>

                                    <input type="radio"
                                           class="btn-check change-status"
                                           name="StatusId-@item.ProdId"
                                           id="unavailable-@item.ProdId"
                                           data-prodid="@item.ProdId"
                                           autocomplete="off"
                                           @(item.Availability ? "" : "checked")>
                                    <label class="btn btn-outline-danger rounded-end-5" for="unavailable-@item.ProdId">Unavailable</label>
                                </div> *@
                                <div class="btn-group status-toggle" role="group" data-prodid="@item.ProdId">
                                    <button type="button"
                                            class="rounded-start-5 btn btn-available @(item.Availability ? "btn-success active" : "btn-outline-success")">
                                        Available
                                    </button>
                                    <button type="button"
                                            class="rounded-end-5 btn btn-unavailable @(item.Availability ? "btn-outline-danger" : "btn-danger active")">
                                        Unavailable
                                    </button>
                                </div>


                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function () {
            window.connection.on("UpdateProductStatus", function (prodid, prodstat) {
                const group = $(`.status-toggle[data-prodid='${prodid}']`);
                if (group.length === 0) return; 

                toggleUI(group, prodstat); 
            });


            $(document).on("click", ".status-toggle .btn", function () {
            const button = $(this);
            const group = button.closest(".status-toggle");
            const id = group.data("prodid");

            const wasAvailable = group.find(".btn-available").hasClass("active");

            toggleUI(group, !wasAvailable);

            fetch('/kitchen/UpdateMenu/' + id)
                .then(response => {
                    if (!response.ok) throw new Error("Server error");
                    return response.json();
                })
                .then(m => {
                    if (m.message === "Error") {
                        AlertModal("Error", "Error changing status");
                        toggleUI(group, wasAvailable); // revert UI
                    }
                })
                .catch(err => {
                    AlertModal("Error", "Network error. Please try again later.");
                    toggleUI(group, wasAvailable); // revert UI
                    console.error(err);
                });
        });

        function toggleUI(group, isAvailable) {
            const availableBtn = group.find(".btn-available");
            const unavailableBtn = group.find(".btn-unavailable");

            if (isAvailable) {
                availableBtn.removeClass("btn-outline-success").addClass("btn-success active");
                unavailableBtn.removeClass("btn-danger active").addClass("btn-outline-danger");
            } else {
                unavailableBtn.removeClass("btn-outline-danger").addClass("btn-danger active");
                availableBtn.removeClass("btn-success active").addClass("btn-outline-success");
            }
        }






            $('#Table').DataTable({
                paging: false,
                searching: true,
                info: false,
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                dom: 'lrtip',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search Tables",
                }
            });

            $('#custom-search-input').on("input", function () {
                $('#Table').DataTable().search($(this).val()).draw();
            });

            $(".custom-filter").on("change", function () {
                $('#Table').DataTable().column(4).search(this.value).draw();
            });

            $('#Table').on('draw.dt', function () {
                $('th:eq(0)').removeClass('sorting sorting_asc sorting_desc').off();
            });

        });
    </script>
}