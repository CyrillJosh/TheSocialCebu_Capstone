@using TheSocialCebu_Capstone.Models
@model List<Order>
@{
    ViewData["Title"] = "Order Status";
}

<div class="render-body vh-100 vw-100">
    <div class="h-100 w-100 p-4 d-flex flex-column">
        <!-- HEADER -->
        @* <div class="d-flex justify-content-evenly align-items-center mb-4"> *@
            <h1 class="text-dark fw-bold text-antonio text-nowrap mb-2">ORDER STATUS</h1>
           @*  <div class="row h-50 input-group gap-2 m-2 d-flex justify-content-end">
                <div class="border border-2 rounded-pill text-dark border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    <input id="custom-search-input" type="text" placeholder="Search" class="border-0 focus-none bg-transparent m-0 p-0" />
                </div>
            </div> *@
        @* </div> *@
        @if (Model == null || !Model.Any())
        {
            <div class="text-center mt-5 text-secondary">
                <h4>No active orders</h4>
            </div>
        }
        else
        {
            @foreach (var order in Model)
            {
                <div class="card mb-4 shadow-sm rounded-3 order-card">
                    <!-- HEADER -->
                    <div class="card-header bg-dark text-light d-flex justify-content-between align-items-center rounded-top-3">
                        <div class="d-flex flex-row gap-3 align-items-center">
                            <div>
                                <div class="p-2 @(order.Table.LocationId == 2 ? "bg-success" :
                                                    order.Table.LocationId == 1 ? "bg-danger" :
                                                    order.Table.LocationId == 4 ? "bg-warning" : "bg-info")
                                            text-black rounded-2 d-flex justify-content-center align-items-center" style="min-height: 50px; min-width:50px">
                                    <h3 class="m-0 p-0 fw-bold">@order.Table.TableNumber</h3>
                                </div>
                            </div>
                            <div>
						        <h4 class="fw-bold">Order #: @order.OrderNumber.ToString("00000") </h4>
                            </div>
                        </div>
                        <div>
                            <h5>@order.CreatedAt</h5>
                        </div>
                    </div>

                    <!-- BODY -->
                    <div class="card-body rounded-bottom-4">
                        <div class="table-responsive">
                            <table class="table align-middle table-borderless mb-0">
                                <thead class="text-secondary small">
                                    <tr>
                                        <th class="col-4">Product</th>
                                        <th class="text-center col-4">Qty</th>
                                        <th class="text-center col-4">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@item.Prod?.ProdName?.ToUpper()</td>
                                            <td class="text-center text-dark">@item.Quantity</td>
                                            <td class="text-center">
                                                @if (item.OrderItemStatusId == 1)
                                                {
                                                    <span class="badge bg-warning text-dark px-3 py-2">PENDING</span>
                                                }
                                                else if (item.OrderItemStatusId == 2)
                                                {
                                                    <span class="badge bg-primary text-dark px-3 py-2">IN PROGRESS</span>
                                                }
                                                else if (item.OrderItemStatusId == 3)
                                                {
                                                    <span class="badge bg-success text-dark px-3 py-2">SERVED</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary text-dark px-3 py-2">UNKNOWN</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

