@using TheSocialCebu_Capstone.Models
@model List<Product>

@{
    ViewData["Title"] = "Product List";
}
<div class="render-body vh-100 vw-100">
    <div class="h-100 w-100 p-4 d-flex flex-column">
        <div class="d-flex justify-content-evenly align-items-center mb-4">
            <h1 class="text-dark fw-bold text-antonio">PRODUCTS</h1>
            <div class="row h-50 input-group gap-2 m-2 d-flex flex-row align-content-center justify-content-end">
                <div class="border border-2 align-self-center rounded-pill text-dark border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    <input id="custom-search-input" type="text" placeholder="Search" class="flex-grow-1 border-0 focus-none bg-transparent m-0 p-0" />
                </div>
            </div>
            <a asp-action="Create" style="min-width:12rem" class="btn btn-primary px-3 rounded-pill py-2">+ New Product</a>
        </div>
        <div class="rounded-2 d-flex px-3 py-3 align-items-center gap-5 border border-dark  text-dark" style="background-color: #0dcaf050">
            <h3 class="text-antonio">LEGEND</h3>
            <div class="d-flex justify-content-between gap-3 fw-bold text-dark">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-pencil-square" style="color: #0d6efd" viewBox="0 0 16 16">
                    <path d="M15.502 1.94a.5.5 0 0 1 0 .506L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .507 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                    <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                </svg>
                EDIT
            </div>
            <div class="d-flex justify-content-between gap-3 fw-bold">
                <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-trash text-danger" viewBox="0 0 16 16">
                    <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                    <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                </svg>
                DELETE
            </div>
        </div>
        <div class="flex-grow-1 overflow-auto table-responsive">
            <table class="table table-hover h-auto align-middle rounded table-separate h-100" id="Table">
                <thead class="sticky-top">
                    <tr>
                        <th class="col">Name</th>
                        <th class="col">Price</th>
                        <th class="col">Category</th>
                        <th class="col">Subcategory</th>
                        <th class="col text-center">Availability</th>
                        <th class="no-sort text-center" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary text-amarath">@item.ProdName.ToUpper()</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary text-start bg-body-secondary text-amarath">@item.Price.ToString("₱0.00")</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary ">@item.Subcategory.Category.CategoryName.ToUpper()</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@item.Subcategory.SubcategoryName.ToUpper()</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary d-flex justify-content-center">
                                <div class="btn-group status-toggle" role="group" data-prodid="@item.ProdId">
                                    <button type="button"
                                            class="rounded-start-5 btn btn-available @(item.Availability ? "btn-success active" : "btn-outline-success")">
                                        Available
                                    </button>
                                    <button type="button"
                                            class="rounded-end-5 btn btn-unavailable @(item.Availability ? "btn-outline-danger" : "btn-danger active")">
                                        Unavailable
                                    </button>
                                </div>
                            </td>
                            <td class="border-2 border-start-0 border-secondary bg-body rounded-end bg-body-secondary" style="border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                                <div class="d-flex justify-content-center w-100">
                                    <a asp-action="Edit" asp-route-id="@item.ProdId" class="btn btn-sm btn-outline-primary border-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .506L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .507 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                        </svg>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger DeleteProduct border-0" data-id="@item.ProdId" data-name="@item.ProdName" data-bs-toggle="modal" data-bs-target="#DeleteModal">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<form asp-action="Delete" method="post">
    <div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-secondary rounded">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="Item"></strong>?
                </div>
                <input type="hidden" name="id" id="DeleteIdInput" />
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </div>
        </div>
    </div>
</form>
<style>
    .dataTables_scroll-foot {
        display: none !important;
    }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
            window.connection.on("UpdateProductStatus", function (prodid, prodstat) {
                const group = $(`.status-toggle[data-prodid='${prodid}']`);
                if (group.length === 0) return; // if product not found in DOM, skip

                toggleUI(group, prodstat); // reuse the same helper from earlier
            });
             $(document).on("click", ".status-toggle .btn", function () {
            const button = $(this);
            const group = button.closest(".status-toggle");
            const id = group.data("prodid");

            // Save current visual state for possible revert
            const wasAvailable = group.find(".btn-available").hasClass("active");

            // Optimistically toggle UI first
            toggleUI(group, !wasAvailable);

            fetch('/kitchen/UpdateMenu/' + id)
                .then(response => {
                    if (!response.ok) throw new Error("Server error");
                    return response.json();
                })
                .then(m => {
                    if (m.message === "Error") {
                        AlertModal("Error", "Error changing status");
                        toggleUI(group, wasAvailable); // revert UI
                    }
                })
                .catch(err => {
                    AlertModal("Error", "Network error. Please try again later.");
                    toggleUI(group, wasAvailable); // revert UI
                    console.error(err);
                });
        });

        function toggleUI(group, isAvailable) {
            const availableBtn = group.find(".btn-available");
            const unavailableBtn = group.find(".btn-unavailable");

            if (isAvailable) {
                availableBtn.removeClass("btn-outline-success").addClass("btn-success active");
                unavailableBtn.removeClass("btn-danger active").addClass("btn-outline-danger");
            } else {
                unavailableBtn.removeClass("btn-outline-danger").addClass("btn-danger active");
                availableBtn.removeClass("btn-success active").addClass("btn-outline-success");
            }
        }
            $('#Table').DataTable({
                paging: false,
                searching: true,
                info: false,
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                dom: 'lrtip',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search Tables",
                }
            });

            $(document).on('click', '.DeleteProduct', function () {
                const productId = $(this).data("id");
                const productName = $(this).data("name");

                $('#Item').text(productName);
                $('#DeleteIdInput').val(productId);
            });

            $('#custom-search-input').on("input", function () {
                $('#Table').DataTable().search($(this).val()).draw();
            });
                
            $(".custom-filter").on("change", function () {
                $('#Table').DataTable().column(4).search(this.value).draw();
            });

            $('#Table').on('draw.dt', function () {
                $('th:eq(0)').removeClass('sorting sorting_asc sorting_desc').off();
            });
        });
    </script>
}