@using TheSocialCebu_Capstone.Models
@model List<Product>

@{
    ViewData["Title"] = "Product List";
}
<div class="render-body vh-100 vw-100">
    <div class="h-100 w-100 p-4 d-flex flex-column">
        <div class="d-flex justify-content-evenly align-items-center mb-4">
            <h1 class="text-dark fw-bold">PRODUCTS</h1>
            <div class="row h-50 input-group gap-2 m-2 d-flex flex-row align-content-center justify-content-end">
                <div class="border border-2 align-self-center rounded-pill text-dark border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
                        <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
                    </svg>
                    <input id="custom-search-input" type="text" placeholder="Search" class="flex-grow-1 border-0 focus-none bg-transparent m-0 p-0" />
                </div>
            </div>
            <a asp-action="Create" style="min-width:12rem" class="btn btn-primary px-3 rounded-pill py-2">+ New Product</a>
        </div>

        <div class="flex-grow-1 overflow-auto table-responsive">
            <table class="table table-hover h-auto align-middle rounded table-separate h-100" id="Table">
                <thead class="sticky-top">
                    <tr>
                        <th class="col">Name</th>
                        <th class="col">Price</th>
                        <th class="col">Category</th>
                        <th class="col">Subcategory</th>
                        <th class="col">Availability</th>
                        <th class="no-sort" scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="border-2 border-end-0 border-secondary rounded-start bg-body-secondary">@item.ProdName</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary text-start bg-body-secondary">@item.Price.ToString("₱0.00")</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@item.Subcategory.Category.CategoryName</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">@item.Subcategory.SubcategoryName</td>
                            <td class="border-2 border-end-0 border-start-0 border-secondary bg-body-secondary">
                                <div class="form-check form-switch">
                                    <input class="form-check-input change p-0 m-0" type="checkbox" id="@item.ProdId" @(item.Availability ? "checked" : "")>
                                </div>
                            </td>
                            <td class="border-2 border-start-0 border-secondary bg-body rounded-end bg-body-secondary" style="border-top-right-radius: 0.5rem; border-bottom-right-radius: 0.5rem;">
                                <div>
                                    <a asp-action="Edit" asp-route-id="@item.ProdId" class="btn btn-sm btn-outline-primary border-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-pencil-square" viewBox="0 0 16 16">
                                            <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z" />
                                            <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z" />
                                        </svg>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-danger DeleteProduct border-0" data-id="@item.ProdId" data-name="@item.ProdName" data-bs-toggle="modal" data-bs-target="#DeleteModal">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                            <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                            <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<form asp-action="Delete" method="post">
    <div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-secondary rounded">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="DeleteModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete <strong id="Item"></strong>?
                </div>
                <input type="hidden" name="id" id="DeleteIdInput" />
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Delete</button>
                </div>
            </div>
        </div>
    </div>
</form>
<style>
    .dataTables_scroll-foot {
        display: none !important;
    }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
             window.connection.on("UpdateProductStatus", function (prodid, prodstat) {
                 if(!prodstat){
                    $(`#${prodid}`).prop("checked", false);
                 }
                 else{
                    $(`#${prodid}`).prop("checked", true);
                 }
            });
              $('.change').on('change', function () {
                const checkbox = $(this);
                const id = checkbox.attr("id");
                const previousState = checkbox.prop("checked"); // save current state

                fetch('/kitchen/UpdateMenu/' + id)
                    .then(response => response.json())
                    .then(m => {
                        if (m.message === "Error") {
                            alert("Error changing status");
                            // revert checkbox to previous state
                            checkbox.prop("checked", !previousState);
                            return;
                        }

                        // Optional: sync checkbox with server's actual availability
                        if (typeof m.availability !== "undefined") {
                            checkbox.prop("checked", m.availability);
                        }
                    })
                    .catch(err => {
                        alert("Network error");
                        // revert checkbox on network failure
                        checkbox.prop("checked", !previousState);
                        console.error(err);
                    });
            });
            $('#Table').DataTable({
                paging: false,
                searching: true,
                info: false,
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                dom: 'lrtip',
                columnDefs: [
                    { targets: 'no-sort', orderable: false }
                ],
                language: {
                    search: "",
                    searchPlaceholder: "Search Tables",
                }
            });

            $(document).on('click', '.DeleteProduct', function () {
                const productId = $(this).data("id");
                const productName = $(this).data("name");

                $('#Item').text(productName);
                $('#DeleteIdInput').val(productId);
            });

            $('#custom-search-input').on("input", function () {
                $('#Table').DataTable().search($(this).val()).draw();
            });
                
            $(".custom-filter").on("change", function () {
                $('#Table').DataTable().column(4).search(this.value).draw();
            });

            $('#Table').on('draw.dt', function () {
                $('th:eq(0)').removeClass('sorting sorting_asc sorting_desc').off();
            });
        });
    </script>
}