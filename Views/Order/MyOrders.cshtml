@using TheSocialCebu_Capstone.Models
@model List<Order>

@{
    ViewData["Title"] = "My Orders";
    string table = Context.Session.GetString("Table");
}
<img hidden src="/Images/donepayment.png" alt="Payment done image"/>
<div class="vh-100 vw-100 d-flex flex-column bg-black">
    <header class="w-100 mb-2 d-flex justify-content-between p-2">
        <!-- Back button -->
        <div class="d-flex flex-row flex-nowrap gap-0 p-2">
            <a class="bg-transparent text-primary m-0 p-0 rounded-1 d-flex align-items-center justify-content-center" style="z-index: 1; min-width: 25px"
               href="/Home/Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                     viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 2 5 8l6 6" />
                </svg>
            </a>
        </div>
        <!-- Title -->
        <h1 class="text-white text-center m-0 p-0 align-self-center text-arbutus">My Orders</h1>

        <!-- Cart -->
        <a class="text-decoration-none text-yellow rounded-1 gotocart position-relative align-self-end m-2 invisible" href="/Order/Cart">
            <img src="~/Images/Cart.png" class="img-fluid" style="height: 30px;">
        </a>
    </header>
    <main class="flex-grow-1 overflow-x-auto pb-5 d-flex flex-column flex-column orders px-3">
        @if (Model.Count() == 0)
        {
            <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                <div class="d-flex flex-column justify-content-center">
                    <img src="/Images/Order.png" height="150" width="150" class="mx-auto d-block" />
                    <h1 class="text-center text-wrap text-antonio" style="font-size:8vh">
                        Your order list
                        is empty.
                    </h1>
                    <p class="mt-3 text-center text-arbutus" style="font-size:2.2vh">Go ahead, savor something delicious!</p>
                </div>
            </div>
        }
        else
        {
            <div class="h-100 w-100 vstack gap-2">
                @foreach (var order in Model.OrderBy(x => x.CreatedAt))
                {
                    <div class="card p-3 rounded-3" style="background: #2F2F2F">
                        <h5 class="text-white text-amarath mb-0">Order No. @order.OrderNumber.ToString("0000")</h5>
                        <p class="text-white fst-italic m-0 p-0 sma">@Convert.ToDateTime(order.CreatedAt).ToString("t").ToUpper()</p>
                        <table class="text-white table-borderless w-100 mt-1">
                            <thead>
                                <tr>
                                    <th class="text-primary fw-light" style="width:10%">Qty</th>
                                    <th class="text-primary fw-light" style="width:60%">Item</th>
                                    <th class="text-primary fw-light" style="width:30%">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OrderItems)
                                {
                                    <tr class="border-top" style="border-color: #616161 !important">
                                        <td class="fw-bold py-2 text-amarath">@item.Quantity</td>
                                        <td class="fw-bold text-amarath" style="letter-spacing:1px">@item.Prod.ProdName.ToUpper()</td>
                                        <td class="stat text-arbutus" id="@item.OrderItemId">@(item.OrderItemStatus.OrderItemStatusId <= 2 ? "PREPARING" : item.OrderItemStatus.StatusName.ToUpper())</td>
                                    </tr>
                                    @if (!string.IsNullOrEmpty(item.Instructions))
                                    {
                                        <tr>
                                            <td colspan="3" class="fst-italic" style="font-size:0.8rem;">
                                                Notes: @item.Instructions
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </main>
    <!-- Bottom Navigation -->
    <footer class="w-100 foot pt-4 bg-transparent">
        @if (Model.All(y => y.OrderStatusId >= 3) && Model.Count > 0)
        {
            <button class="btn btn-primary rounded-pill d-block mx-auto w-75 z-5 mb-4" id="Req" data-id="@table" @(Model.First().Table.TableStatusId >= 3 && Model.First().Table.TableStatusId < 5 ? "disabled" : "")>@(Model.First().Table.TableStatusId >= 3 && Model.First().Table.TableStatusId < 5 ? "Bill Requested" : "Request Bill")</button>
        }
        <div class="w-100 border-top bg-secondary d-flex justify-content-evenly align-items-center text-white pt-4"
              style="padding-bottom: 10vh">
            <a class="text-decoration-none d-flex flex-column align-items-center" href="/Home/Index">
                <img src="/Images/Home.png" class="img-fluid" style="max-height: 30px; filter: brightness(1) saturate(0%);" />
                <small class="text-white">Home</small>
            </a>
            <a class="text-decoration-none d-flex flex-column align-items-center" href="/Order/MyOrders/@table">
                <img src="/Images/Orders.png" class="img-fluid" style="max-height: 30px; " />
                <small class="text-primary">Orders</small>
            </a>
        </div>
    </footer>
</div>
<!-- FeedbackModal -->
<div class="modal fade" id="FeedbackModal" tabindex="-1" aria-labelledby="FeedbackModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered p-2">
        <div class="modal-content bg-dark">
            <div class="modal-body d-flex flex-column">
                <h1 class="text-white text-center my-5 text-arbutus">Requesting bill</h1>
                <h3 class="text-center text-white mt-2 text-amarath">How was your experience?</h3>
                <div class="d-flex justify-content-center gap-2 mb-2">
                    @for(int i = 1; i<=5; i++ )
                    {
                        <button type="button" value="@i" class="btn star m-0 p-0" data-rating="@i">
                            <img src="~/Images/Star.png" class="img-fluid star-img" style="height: 40px; width: 40px;" />
                        </button>
                    }
                </div>
                <input type="hidden" id="RatingValue" name="RatingValue" value="0" />

                <hr class="text-white" style="height: 2px"/>
                <div class="d-flex flex-column">
                    <button class="btn btn-primary text-black rounded-pill submitfeedback mt-5">Submit</button>
                    <button class="btn mt-2 text-white rounded-pill" data-bs-dismiss="modal">Skip</button>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    input::placeholder {
        color: white !important;
        opacity: 1 !important;
	}
</style>
@section Scripts{
    <script>
        $(document).ready(function () {
            window.connection.on("DonePayment", function(table){
                let currentTable = '@table';
                if(currentTable === table){
                    console.log("Payment done for table: " + table);
                    fetch('/Order/ClearMySession', { method: 'POST' })
                    .then(() => {
                        console.log("Session cleared");
                        $("body").empty();
                        $("body").removeClass("row");
                        $("body").append(`
                            <div style="overflow: hidden; width:100vw; height:100vh; display:flex; justify-content:center; align-items:center; background-color:black;">
                                <img src="/Images/donepayment.png" alt="Payment Done" style="height: 100%; width: 100%; object-fit: cover"/>
                            </div>
                        `);
                    })
                }
            });


            let height = $("#req").outerHeight();
            $("main").css("margin-bottom", `-${height}px`);

            window.connection.on("NewOrder",function(order){
                console.log("New order received:", order);
                if(order.table.tableId == "@table"){
                    location.reload();
				}
            });

            window.connection.on("UpdateOrderStatus", function (orderid, orderstat) {
                console.log(orderid, orderstat);
                $(`[id='${orderid}']`).text(orderstat.toUpperCase());
                allServed();
            });
            function allServed() {
                let allServed = true;

                $(".stat").each(function () {
                    console.log($(this).text().trim())
                    if ($(this).text().trim() !== "SERVED") {
                        allServed = false;
                        return false; // exit the loop early
                    }
                });
                if(allServed){
                     if ($("#Req").length === 0) {
                        $(".foot").prepend(`<button class="btn btn-primary rounded-pill d-block mx-auto w-75 z-5 mb-4" id="Req" data-id="@table">Request Bill</button>`);
                    }
                }
                return allServed;
            }
            $(".star").click(function () {
                var rating = $(this).data("rating");
                $("#RatingValue").val(rating);
                console.log(rating)
                $(".star").each(function () {
                    if ($(this).data("rating") <= rating) {
                        $(this).find("img").attr("src","/Images/StarFilled.png");
                    }
                    else{
                        $(this).find("img").attr("src","/Images/Star.png");

                    }
                });
            });
                    $(document).on("click", "#Req", function () {
            let id = $(this).data("id");

            fetch(`/Order/RequestBill`, {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: new URLSearchParams({ tableid: id })
            })
            .then(response => response.json())
            .then(x => {
                if(x.success){
                    $(this).text("Bill Requested");
                    $("#FeedbackModal").modal("show");
                } else {
                    AlertModal("Error", x.message);
                }
            });
        });


            $(".submitfeedback").on("click", function(){
                let rating = $("#RatingValue").val();
                fetch(`/Marketing/Rate?rate=${rating}`)
                .then(response => response.json())
                .then(x => {
                    if(x.success){
                        AlertModal("Success","Thank you for your feedback!");
                        $("#FeedbackModal").modal("hide");
                    }else{
                        AlertModal("Error",x.message);
                    }
                })
			})
        })
    </script>
}