@using TheSocialCebu_Capstone.Models
@using TheSocialCebu_Capstone.ViewModels
@model List<TheSocialCebu_Capstone.Models.TableSession>

@{
    ViewData["Title"] = "My Orders";
    string table = Context.Session.GetString("Table");
}

<div class="render-body vh-100 overflow-y-scroll bg-black">
    <nav id="categoryNav"
         class="nav flex-row bg-dark w-100 p-2 sticky-top"
         style="height: 10vh; top: 0; z-index: 1020;">
        <div class="w-100 mb-2" style="min-height: 20px">
            <button class="btn bg-transparent text-yellow m-2 position-absolute start-0 top-0 d-sm-none"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#sidebarMenu"
                    aria-controls="sidebarMenu">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                </svg>
            </button>
            <h1 class="text-white position-absolute my-2 start-50 top-0 translate-middle-x">Orders</h1>
            <a class="text-decoration-none text-yellow m-2 py-2 px-3 rounded-1 position-absolute end-0 top-0"
               href="/Order/Cart">
                Return
            </a>
        </div>
    </nav>
    <div class="p-3 pb-5 mb-5">
        @if (!Model.Any(s => s.Orders.Any()))
        {
            <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                <div class="d-flex flex-column justify-content-center">
                    <img src="/Images/ThinCart.png" height="170" width="170" class="mx-auto d-block" />
                    <h1 class="text-center text-wrap">You have no active orders.</h1>
                    <p class="mt-3">Ready to order? Go back to the menu!</p>
                </div>
            </div>
        }
        else
        {
            <div class="h-100 w-100 vstack gap-2">
            @foreach (var session in Model.Where(x => x.Orders.Any()))
            {
                <div class="card bg-dark p-2">
                    @* <h5 class="text-white">Order</h5>
                    <p class="text-white">@Convert.ToDateTime(session.Orders.CreatedAt).ToString("T").ToUpper()</p> *@
                    <table class="table text-white table-borderless bg-transparent">
                        <thead class="bg-transparent">
                            <tr class="bg-transparent">
                                <th class="text-yellow bg-transparent">Qty</th>
                                <th class="text-yellow bg-transparent">Item</th>
                                <th class="text-yellow bg-transparent">Status</th>
                            </tr>
                        </thead>
                        <tbody class="bg-transparent">
                            @foreach (var item in session.Orders.SelectMany(x => x.OrderItems))
                            {
                                <tr></tr>
                                <tr class="border border-bottom-0 border-start-0 border-end-0 border-white">
                                    <td class="bg-transparent text-white">@item.Quantity</td>
                                    <td class="bg-transparent text-white">@item.Prod.ProdName</td>
                                    <td class="bg-transparent text-white">@item.OrderItemStatus.StatusName</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(item.Instructions))
                                {
                                    <tr>
                                        <td colspan="5" class="fst-italic" style="font-size: 0.8rem;">
                                            Notes: @item.Instructions
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    @*   <h4 class="text-white text-end fw-bold mt-4">
                        Total: @string.Format("₱ {0:N2}", order.OrderItems.Sum(oi => oi.Prod.Price * oi.Quantity))
                    </h4> *@
                </div>
            }
            </div>
        }
    </div>
    @if(Model.All(x => x.Orders.All(y => y.OrderStatusId == 3)))
    {
        <button class="btn btn-warning d-block mx-auto">Request Bill</button>
    }
    <div class="position-fixed w-100 bg-black py-3 bottom-0 d-flex justify-content-evenly align-items-center z-2 text-white border-top rounded-top-1" style="background: #151515;">
        <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Home/Index">
            <img src="/Images/Home.png" height="20" width="20" class="d-block mx-auto" />
            <p class="m-0 text-white">Home</p>
        </a>
        <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Order/MyOrders/@table">
            <img src="/Images/Orders.png" height="20" width="20" class="d-block mx-auto" style="filter: brightness(0) saturate(100%) invert(89%) sepia(90%) saturate(937%) hue-rotate(360deg) brightness(102%) contrast(103%)" />
            <p class="m-0 text-yellow">Orders</p>
        </a>
    </div>
</div>