@using TheSocialCebu_Capstone.Models.OrderClasses
@{
	ViewData["Title"] = "My Orders";
	string table = Context.Session.GetString("Table");
}
@model List<Order>
<div class="render-body vh-100 overflow-y-scroll bg-black">
<nav id="categoryNav"
	 class="nav flex-row bg-dark w-100 p-2 sticky-top"
	 style="height: 10vh; top: 0; z-index: 1020;">
	<div class="w-100 mb-2" style="min-height: 20px">
		<button class="btn bg-transparent text-yellow m-2 position-absolute start-0 top-0 d-sm-none"
				type="button"
				data-bs-toggle="offcanvas"
				data-bs-target="#sidebarMenu"
				aria-controls="sidebarMenu">
			<svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
				<path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
			</svg>
		</button>
		<h1 class="text-white position-absolute my-2 start-50 top-0 translate-middle-x">Orders</h1>
		<a class="text-decoration-none text-yellow m-2 py-2 px-3 rounded-1 position-absolute end-0 top-0"
		   href="/Order/Cart">Return
		</a>
	</div>
</nav>
	<div class="p-3">
		@foreach (var order in Model)
		{
			<h5>@order.Status</h5>
			<table class="table">
			<thead>
				<tr>
					<th>Name</th>
					<th>Quantity</th>
					<th>Price</th>
					<th>Subtotal</th>
				</tr>
			</thead>
			<tbody>
			@foreach (var item in order.OrderItems)
			{
					<tr>
						<td>@item.Prod.ProdName</td>
						<td>@item.Quantity</td>
						<td>@item.Prod.Price</td>
						<td>@(item.Prod.Price* item.Quantity)</td>
					</tr>
				@* <h2>Total: @Model.Select(x => x.OrderItems).ToString("0.00")</h2> *@
			}
			</tbody>
			</table>
		}

		<button class="btn btn-yellow">Request Bill</button>
		<div class="position-fixed w-100 bg-black py-3 bottom-0 d-flex justify-content-evenly align-items-center z-2 text-white border-top rounded-top-1" style="background: #151515;">
			<a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Home/Index">
				<img src="/Images/Home.png" height="20" width="20" class="d-block mx-auto"/>
				<p class="m-0 text-white">Home</p>
			</a>
			<a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Order/MyOrders/@table">
				<img src="/Images/Orders.png" height="20" width="20" class="d-block mx-auto" style="filter: brightness(0) saturate(100%) invert(89%) sepia(90%) saturate(937%) hue-rotate(360deg) brightness(102%) contrast(103%)" />
				<p class="m-0 text-yellow">Orders</p>
			</a>
			@*         <div class="d-flex flex-column align-items-center w-25 text-center">
            <img src="/Images/Notifications.png" height="20" width="20" class="d-block mx-auto" />
            <p class="m-0">Notifications</p>
        </div> *@
		</div>
	</div>
</div>