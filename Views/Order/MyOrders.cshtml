@using TheSocialCebu_Capstone.Models
@model List<Order>

@{
    ViewData["Title"] = "My Orders";
    string table = Context.Session.GetString("Table");
}

<div class="render-body vh-100 overflow-y-scroll bg-black">
    <nav id="categoryNav"
         class="nav flex-row bg-dark w-100 p-2 sticky-top"
         style="height: 10vh; top: 0; z-index: 1020;">
        <div class="w-100 mb-2" style="min-height: 20px">
            <div class="d-flex flex-row flex-nowrap gap-0">
                <a class="bg-yellow text-black m-0 p-0 rounded-1 d-flex align-items-center justify-content-center"
                    onclick="history.back()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="20" fill="currentColor" class="bi bi-chevron-left" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0" />
                    </svg>
                </a>
            </div>
            <h1 class="text-white position-absolute my-2 start-50 top-0 translate-middle-x">Orders</h1>
        </div>
    </nav>
    <div class="p-3 pb-5 mb-5">
        @if (Model.Count() == 0)
        {
            <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                <div class="d-flex flex-column justify-content-center">
                    <img src="/Images/Order.png" height="170" width="170" class="mx-auto d-block" />
                    <h1 class="text-center text-wrap">
                        Your order list
                        is empty.
                    </h1>
                    <p class="mt-3 text-center">Go ahead, savor something delicious!</p>
                </div>
            </div>
        }
        else
        {
            <div class="h-100 w-100 vstack gap-2">
            @foreach (var order in Model)
            {
                <div class="card bg-dark p-2">
                  <h5 class="text-white">Order</h5>
                    <p class="text-white">@Convert.ToDateTime(order.CreatedAt).ToString("T").ToUpper()</p>
                    <table class="table text-white table-borderless bg-transparent">
                        <thead class="bg-transparent">
                            <tr class="bg-transparent">
                                <th class="text-yellow bg-transparent">Qty</th>
                                <th class="text-yellow bg-transparent">Item</th>
                                <th class="text-yellow bg-transparent">Status</th>
                            </tr>
                        </thead>
                        <tbody class="bg-transparent">
                            @foreach (var item in order.OrderItems)
                            {
                                <tr></tr>
                                <tr class="border border-bottom-0 border-start-0 border-end-0 border-white">
                                    <td class="bg-transparent text-white">@item.Quantity</td>
                                    <td class="bg-transparent text-white">@item.Prod.ProdName</td>
                                    <td class="bg-transparent text-white">@item.OrderItemStatus.StatusName</td>
                                </tr>
                                @if (!string.IsNullOrEmpty(item.Instructions))
                                {
                                    <tr>
                                        <td colspan="5" class="fst-italic" style="font-size: 0.8rem;">
                                            Notes: @item.Instructions
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                        <h4 class="text-white text-end fw-bold mt-4">
                        Total: @string.Format("₱ {0:N2}", order.OrderItems.Sum(oi => oi.Prod.Price * oi.Quantity))
                    </h4> 
                </div>
            }
            </div>
        }
    </div>
    @if(Model.All(y => y.OrderStatusId >= 3) && Model.Count > 0)
    {
        <button class="btn btn-warning d-block mx-auto" id="Req"data-id="@table">Request Bill</button>
    }
    <div class="position-fixed w-100 bg-black py-3 bottom-0 start-0 d-flex justify-content-evenly align-items-center z-2 text-white border-top rounded-top-1" style="background: #151515;">
        <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Home/Index">
            <img src="/Images/Home.png" height="20" width="20" class="d-block mx-auto" style="filter: brightness(1) saturate(0%)" />
            <p class="m-0  text-white">Home</p>
        </a>
        <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Order/MyOrders/@table">
            <img src="/Images/Orders.png" height="20" width="20" class="d-block mx-auto" />
            <p class="m-0 text-yellow">Orders</p>
        </a>
        @*         <div class="d-flex flex-column align-items-center w-25 text-center">
            <img src="/Images/Notifications.png" height="20" width="20" class="d-block mx-auto" />
            <p class="m-0">Notifications</p>
        </div> *@
    </div>
</div> 

@section Scripts{
    <script>
        $(document).ready(function () {
               $("#Req").on("click", function () {
                    let id = $(this).data("id");

                    fetch(`/Order/RequestBill?tableid=${id}`)
                    .then(response => response.json())
                    .then(x => {
                        console.log(x)
                           alert(x.message)
                    })
               })
        })
    </script>
}