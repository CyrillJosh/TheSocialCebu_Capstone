@using TheSocialCebu_Capstone.Models.OrderClasses
@model List<OrderItem>
@{
    ViewData["Title"] = "Cart";
    string table = Context.Session.GetString("Table");
}
<div class="vh-100 w-100 render-body">
    <nav id="categoryNav"
    class="nav flex-row bg-dark w-100 p-2 sticky-top"
    style="height: 10vh; top: 0; z-index: 1020;">
        <div class="w-100 mb-2" style="min-height: 20px">
            <button class="btn bg-transparent text-yellow m-2 position-absolute start-0 top-0 d-sm-none"
            type="button"
            data-bs-toggle="offcanvas"
            data-bs-target="#sidebarMenu"
            aria-controls="sidebarMenu">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor" class="bi bi-list" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
                </svg>
            </button>
            <h1 class="text-white position-absolute my-2 start-50 top-0 translate-middle-x">Your Cart</h1>
            <a class="text-decoration-none text-yellow m-2 py-2 px-3 rounded-1 position-absolute end-0 top-0"
               href="/Menu/Menu/@table">
                Return
            </a>
        </div>
    </nav>
    <div class="pt-4 h-100 d-flex flex-column">
        <div class="row row-cols-1 gap-2 px-4 py-2 overflow-y-scroll order-body" style="height: 65vh">
            @foreach(var item in Model)
            {
                        }
                    </div>

                    <div class="d-flex align-items-center gap-3 ">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-dash-circle minus" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                        </svg>
                        <span id="qty">@item.Qty</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-plus-circle add" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                            <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                        </svg>
                    </div>
                    @*<div> 
                        <button class="btn btn-close"></button>
                    </div>*@
                </div>
            }
        </div>
        <div class="w-100 bg-dark pt-4 px-4" style="height: 25vh">
            <div class="h-100">
                <div class="d-flex justify-content-between">
                    <h5 class="text-light fw-bold">Total</h5>
                    <span class="text-light fw-bold total">₱@Model.Sum(x => x.Prod.Price * x.Qty)</span>
                </div>
                <div class="d-flex justify-content-evenly mt-auto">
                    <a class="btn btn-primary rounded-pill px-5" data-bs-toggle="modal" data-bs-target="#ConfirmModal">Add to Order</a>
                    <a class="btn btn-yellow rounded-pill px-5" asp-controller="Order" asp-action="MyOrders">View Order</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="ConfirmModal" tabindex="-1" aria-labelledby="ConfirmModal" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-secondary rounded">
            <div class="modal-header border-0">
                <h5 class="modal-title text-center" id="DeleteModalLabel">Confirm Order?</h5>
                <button type="button" class="btn-close btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <p class="text-start">Cancellation are not available</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger px-4 checkout" data-bs-dismiss="modal">Confirm</button>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function (){
            $(".checkout").on("click", ()=> {
                const tableId = "@table";
                .then(rawData => rawData.json())
                .then(data => {
                    alert(data.message)
                    $(".order-body").empty()
                    $(".total").text("0.00")
                })
            })
        })
    </script>
}