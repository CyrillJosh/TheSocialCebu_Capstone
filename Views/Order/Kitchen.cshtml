@using TheSocialCebu_Capstone.Models
@{
	ViewData["Title"] = "Kitchen";
}
@model List<Order>
<div class="render-body vh-100">
	<div class="p-4 h-100">
		<div class="row row-cols-2 ">
			<h1>Orders</h1>
			<div class="col-9 d-flex flex-column gap-3">
				@foreach (var order in Model.Where(x => x.OrderStatusId == 1))
				{
					<div class="border border-1 shadow rounded-3 p-3">
						<div>
							<div class="d-flex justify-content-between align-items-center">
								<h3>@order.OrderStatusId</h3>
								<p>@order.OrderId</p>
								@if (order.OrderStatusId == 1)
								{
									<button class="btn btn-primary confirm" data-id="@order.OrderId">Confirm</button>
								}
							</div>
							<div>
								<table>
									<thead>
										<tr>
											@* <th>Check</th> *@
											<th>Product Name</th>
											<th>Quantity</th>
										</tr>
									</thead>
									<tbody>
									@foreach(var item in order.OrderItems)
									{
										<tr>
											@* <td><input type="checkbox" checked/></td> *@
											<td>@item.Prod.ProdName</td>
											<td>@item.Quantity</td>
										</tr>
									}
									</tbody>
								</table>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	</div>
</div>

	@section Scripts {
	<script>
		$(document).ready( function () {
			const buttons = $(".confirm")
			$.each(buttons, (index, value) => {
				let button = value;
				button.addEventListener("click", (e) =>{
					let id =  e.currentTarget.dataset.id;
					fetch(`/Order/ConfirmOrder?id=${id}&status=Preparing`)
					.then(response => response.json())
					.then(confirm => {
						console.log(confirm)
						if(confirm.message == "OK"){
							window.location.reload();
						}
					})
				})
			})
		})
	</script>
}
