@using TheSocialCebu_Capstone.Models
@{
	ViewData["Title"] = "Kitchen";
}
@model List<Order>
<div class="render-body vh-100">
	<div class="p-4 h-100 ">
		<div class="row h-100">
			<div class="col-8 h-100">
				<h1>Orders</h1>
				<button class="btn btn-light type">Approved</button>
				<button class="btn btn-yellow type">Pending</button>
				<div class="w-100 h-100 pt-2">
					<div class="d-flex flex-column overflow-y-scroll h-100 gap-3">
						@foreach (var order in Model)
						{
							<div class="border border-1 shadow rounded-3 p-2 hstack gap-3 me-2 Order visually-hidden @order.OrderStatus.StatusName" id="@order.OrderId">
								<div class="p-2 px-3 bg-primary">
									<h3>@order.Session.Table.TableNumber</h3>
								</div>
								<div class="d-flex flex-column justify-content-center">
									<p class="m-0 fw-bold">Order #: @order.OrderId</p>
									<p class="m-0">@Convert.ToDateTime(order.CreatedAt).ToString("T").ToUpper()</p>
								</div>
							</div>
						}
					</div>
				</div>
			</div>
			<div class="col-4 h-100">
				<h1>Order Details</h1>
				<div id="OrderDetails">
					<p>Select an order to view details</p>
					@foreach (var order in Model)
					{
						<div class="border border-1 shadow rounded-3 p-3 visually-hidden OrderDetails" id="@order.OrderId">
							<div>
								<div class="p-2 hstack gap-3 me-2">
									<div class="p-2 px-3 bg-primary">
										<h3>@order.Session.Table.TableNumber</h3>
									</div>
									<div class="d-flex flex-column justify-content-center">
										<p class="m-0 fw-bold">Order #: @order.OrderId</p>
										<p class="m-0">@Convert.ToDateTime(order.CreatedAt).ToString("T").ToUpper()</p>
									</div>
								</div>
								<hr />
								<div class="w-100 overflow-y-scroll" style="min-height: 300px">
									<table class="w-100">
										<thead>
											<tr>
												<th></th>
												<th></th>
												<th></th>
											</tr>
										</thead>
										<tbody id="@("body" + order.OrderId)">
											@foreach (var item in order.OrderItems)
											{
												<tr id="@item.OrderItemId" class="Orderitem">
													<td>
														<div>
															<h5>@item.Prod.ProdName</h5>
															<p class="fst-italic">@(string.IsNullOrEmpty(item.Instructions)? "" : "Instructions: " + item.Instructions )</p>
														</div>
													</td>
													<td>
														<div class="hstack align-items-center justify-content-between">
															@* <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash text-black m-0 bg-yellow rounded-pill" viewBox="0 0 16 16">
																<path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
															</svg> *@
															<p id="qty" class="m-0">@item.Quantity</p>
															@* <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus text-black m-0 bg-yellow rounded-pill" viewBox="0 0 16 16">
																<path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
															</svg> *@
														</div>
													</td>
													@if(item.OrderItemStatus.StatusName != "Served")
													{
														<td class="ps-4"><input type="checkbox" checked/>@* @item.OrderItemStatus.StatusName *@</td>
													}
												</tr>
											}
										</tbody>
									</table>
								</div>
								@if(order.OrderStatus.StatusName != "Confirmed"){
									<button class="text-center d-block mx-auto mt-auto btn btn-yellow shadow px-5 confirm" id="@order.OrderId">Confirm</button>
								}
								else if (order.OrderStatus.StatusName == "Confirmed")
								{
									<button class="text-center d-block mx-auto mt-auto btn btn-yellow shadow px-5 confirm" id="@order.OrderId">Ready to Serve</button>
								}
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>

	@section Scripts {
	<script>
		$(document).ready( function () {
			$(".Order." + "Pending").removeClass("visually-hidden");


			$(".Order").on("click", function () {
				let id = $(this).attr("id");
				$(".OrderDetails").addClass("visually-hidden");
				$("#" + id + ".OrderDetails").removeClass("visually-hidden");
			})

			$(".type").on("click", function () {
				let status = $(this).text().trim() == "Approved" ? "Confirmed" : $(this).text().trim();
				$(".Order").addClass("visually-hidden");
				$(".Order." + status).removeClass("visually-hidden");

				$(".type").addClass("btn-light");
				$(this).removeClass("btn-light")
				$(this).addClass("btn-yellow");
			});


			//Get current items where it is checked and get its quantity 
			$(".confirm").on("click", function (){
				let id = $(this).attr("id");
				const orderitems = $(`#body${id}`).children()
				let items = [];
				orderitems.each(function(){
					let checkbox = $(this).children().last().children().first();
					if(checkbox.is(":checked")){
						items.push($(this).attr("id"))
					}
				})

				console.log(items)
				fetch(`/Order/ConfirmOrder?id=${items.join(",")}&orderid=${id}`)
				.then(response => response.json())
				.then(confirm => {
					console.log(confirm)
					if(confirm.message == "Success"){
						window.location.reload();
					}
				})
				// fetch(`/Order/ConfirmOrder?id=${id}&status=Preparing`)
				// .then(response => response.json())
				// .then(confirm => {
				// 	console.log(confirm)
				// 	if(confirm.message == "OK"){
				// 		window.location.reload();
				// 	}
				// })
			})
		})
	</script>
}
