<div class="offcanvas offcanvas-bottom bg-dark h-50 pb-3 rounded rounded-top-4 text-white border border-1 border-start-0 border-bottom-0 border-end-0" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel">
    <button type="button" class="text-light bg-transparent border border-0 position-absolute top-0 end-0 m-4 " data-bs-dismiss="offcanvas" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
        </svg>
    </button>
    <div class="offcanvas-body p-5">
        <h1>Confirm Order?</h1>
        <h5>Note: Orders are not cancellable</h5>
        <p>if you want to cancel orders please ask for staff assistance</p>
        <div class="w-100 d-flex justify-content-between text-black">
            <button class="bg-body-secondary border-0 rounded-pill py-2 px-5" data-bs-dismiss="offcanvas" aria-label="Close">CANCEL</button>
            <button class="bg-yellow border-0 rounded-pill py-2 px-5 confirm">CONFIRM</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function (){
            $(".bi-plus").on("click", function () {
                let id =  $(this).data("id");
                fetch(`/Order/UpdateQuantity?id=${id}&type=Add`)
                .then(rawData => rawData.json())
                .then(data => {
                    const qty = $(`#qty${id}`)
                    const price = $(`#price${id}`)

                    let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                    let num = parseInt(qty.text())
                    let basePrice = currentPrice / num

                    num++

                    qty.text(num.toString().padStart(2, "0"));
                    price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))

                })
            })
            $(".bi-dash").on("click", function () {
                let id =  $(this).data("id");
                fetch(`/Order/UpdateQuantity?id=${id}&type=Minus`)
                .then(rawData => rawData.json())
                .then(data => {
                    const qty = $(`#qty${id}`)
                    const price = $(`#price${id}`)

                    let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                    let num = parseInt(qty.text())
                    let basePrice = currentPrice / num
                    if((num-1) == 0){
                        num = 1
                    }
                    else{
                        num--
                    }
                    qty.text(num.toString().padStart(2, "0"));
                    price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))
                })
            })

            function getOrders() {
                let orders = sessionStorage.getItem("Orders");
                if (orders) {
                    return JSON.parse(orders);
                }
                return [];
            }

            function saveCart(orders) {
                sessionStorage.setItem("Orders", JSON.stringify(orders));
            }

            function updateOrder(id, type) {
                let orders = getOrders();

                switch (type) {
                    case "Add":
                        let addOrder = orders.find(x => x.orderItemId === id);
                        if (addOrder) {
                            addOrder.quantity++;
                        }
                        break;

                    case "Minus":
                        let order = orders.find(x => x.orderItemId === id);
                        if (order) {
                            if (order.quantity - 1 === 0) {
                                order.quantity = 1;
                            } else {
                                order.quantity--;
                            }
                        }
                        break;
                }

                saveCart(orders);
                return { orders: orders, message: "Success" };
            }

            $(".checkout").on("click", ()=> {
                const tableId = "@table";
                fetch(`/Order/ConfirmCart?id=${tableId}`)
                .then(rawData => rawData.json())
                .then(data => {
                    alert(data.message)
                    $(".order-body").empty()
                    $(".total").text("0.00")
                })
            })

            //Add confirmation
            $(".remove").on("click", function () {
                let id = $(this).data("id");
                fetch(`/Order/RemoveFromCart/${id}`)
                .then(response => response.json())
                .then(m => {
                    window.location.reload()
                })
            });

             $(".confirm").on("click", function () {
        // The C# action doesn't use the ID, so we can remove it from the fetch URL.
        // The session ID is already handled on the server.
        fetch(`/Order/ConfirmCart`)
            .then(response => response.json())
            .then(m => {
                console.log(m)
                let setheight = $(".offcanvas")
                setheight.removeClass("h-50")
                setheight.addClass("h-75")
                let content = $(".offcanvas-body")
                content.empty()

                content.append(`
                <div class="h-100 w-100 d-flex flex-column justify-content-center text-center gap-2">
                    <img src="/Images/Check.png" height="125" width="125" class="d-block mx-auto"/>
                    <h1>Thank you for your order!</h1>
                    <p>
                        Every bite has a story,<br />
                        and we’re here to make<br />
                        sure you enjoy every taste.
                    </p>
                    <div>
                        <a class="btn btn-yellow w-100 rounded-pill mb-2" href="/Order/MyOrders/">VIEW MY ORDER</a>
                        <a class="text-decoration-none text-white" href="/Home/Index">ORDER MORE</a>
                    </div>
                </div>
                `)

                // You had a bug here, you were trying to access a C# variable
                // from within the JavaScript context, which won't work.
                // But since the order has been confirmed and the session cleared,
                // the logic below to empty the cart display is still fine.
                // Just remember to remove the @orders part.
                $(".orders").empty();
                $(".orders").append(`
                <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                    <div class="d-flex flex-column justify-content-center">
                        <img src="/Images/ThinCart.png" height="170" width="170" class="mx-auto d-block" />
                        <h1 class="text-center text-wrap">Your cart is<br />waiting...</h1>
                        <p class="mt-3">Time to add what you’re craving!</p>
                    </div>
                </div>
                `)
            })
        })
    })
    </script>
}