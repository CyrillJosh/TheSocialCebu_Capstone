@using System.Text.Json
@using TheSocialCebu_Capstone.Models.OrderClasses
@model List<OrderItem>
@{
    ViewData["Title"] = "Cart";
    string table = Context.Session.GetString("Table");
    var ordersJson = Context.Session.GetString("Orders");
    var orders = string.IsNullOrEmpty(ordersJson)
          ? new List<OrderItem>()
          : JsonSerializer.Deserialize<List<OrderItem>>(ordersJson);
}
<div class="d-flex flex-column h-100 w-100 bg-black position-relative">

    <div class="d-flex flex-row align-items-center p-2 bg-black text-white position-relative">
        <button class="btn bg-transparent text-yellow m-0 p-0 d-sm-none"
                type="button"
                data-bs-toggle="offcanvas"
                data-bs-target="#sidebarMenu"
                aria-controls="sidebarMenu">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" fill="currentColor"
                 class="bi bi-list" viewBox="0 0 16 16">
                <path fill-rule="evenodd"
                      d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5" />
            </svg>
        </button>
        <a class="bg-yellow text-black ms-2 p-1 rounded-1 d-flex align-items-center justify-content-center back"
           href="/Home/Index">
            <svg width="12" height="17" viewBox="0 0 9 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0.726422 6.6928C0.335897 7.08332 0.335897 7.71648 0.726422 8.10701L7.09038 14.471C7.48091 14.8615 8.11407 14.8615 8.5046 14.471C8.89512 14.0804 8.89512 13.4473 8.5046 13.0568L2.84774 7.3999L8.5046 1.74305C8.89512 1.35252 8.89512 0.719358 8.5046 0.328834C8.11407 -0.0616907 7.48091 -0.0616907 7.09038 0.328834L0.726422 6.6928ZM2.2002 7.3999V6.3999H1.43353V7.3999V8.3999H2.2002V7.3999Z" fill="black" />
            </svg>

        </a>
        <h1 class="position-absolute top-50 start-50 translate-middle text-center m-0">My Cart</h1>
    </div>

    <div class="flex-grow-1 overflow-y-auto">
        <div class="container-fluid py-2 h-100">
            <div class="flex-column flex-column h-100 orders">
                @if(Model.Count == 0)
                {
                    <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                        <div class="d-flex flex-column justify-content-center">
                            <img src="/Images/ThinCart.png" height="170" width="170" class="mx-auto d-block" />
                            <h1 class="text-center text-wrap">Your cart is<br />waiting...</h1>
                            <p class="mt-3">Time to add what you’re craving!</p>
                        </div>
                    </div>
                }
                else
                @foreach (var item in Model)
                {
                    <div class="w-100 text-light py-3 px-4 rounded-3 my-2 mx-0 position-relative"
                         style="background: linear-gradient(345deg, rgba(255, 255, 255, 0.084) 48.8%, rgba(255, 255, 255, 0.284) 90.74%); backdrop-filter: blur(80px)">

                        <div class="row">
                            <div class="col-8">
                                <h3 class="fw-bold">@item.Prod.ProdName.ToUpper()</h3>
                                <p style="font-size:10px">@item.Instructions</p>
                                <h2>@item.Prod.Price.ToString("₱ 0.00")</h2>
                            </div>
                            <div class="col-4 d-flex align-items-end pb-2">
                                <div class="rounded-pill bg-yellow d-flex gap-2 justify-content-center align-items-center text-black">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-dash text-black" viewBox="0 0 16 16">
                                        <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                    </svg>
                                        <p id="qty" class="m-0">@item.Quantity</p>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-plus text-black" viewBox="0 0 16 16">
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="text-light bg-transparent border-0 position-absolute top-0 end-0 p-2 remove" data-id="@item.OrderItemId">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                                 fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                                <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="position-fixed bottom-0 w-100 bg-transparent">
        <div class="p-4 bg-transparent">
            <button class="btn btn-yellow w-100 rounded-pill fw-bold" data-bs-toggle="offcanvas" data-bs-target="#offcanvasBottom">
                CHECKOUT
            </button>
        </div>
        <div class="bg-black py-3 d-flex justify-content-evenly align-items-center z-2 text-white border-top rounded-top-1" style="background: #151515;">
            <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Home/Index">
                <img src="/Images/Home.png" height="20" width="20" class="d-block mx-auto" style="filter: brightness(0) saturate(100%) invert(89%) sepia(90%) saturate(937%) hue-rotate(360deg) brightness(102%) contrast(103%)" />
                <p class="m-0 text-yellow">Home</p>
            </a>
            <a class="text-decoration-none d-flex flex-column align-items-center w-25 text-center" href="/Order/MyOrders/@table">
                <img src="/Images/Orders.png" height="20" width="20" class="d-block mx-auto" />
                <p class="m-0 text-white">Orders</p>
            </a>
            @*         <div class="d-flex flex-column align-items-center w-25 text-center">
                <img src="/Images/Notifications.png" height="20" width="20" class="d-block mx-auto" />
                <p class="m-0">Notifications</p>
            </div> *@
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-bottom bg-dark h-50 pb-3 rounded rounded-top-4 text-white border border-1 border-start-0 border-bottom-0 border-end-0" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel">
    <button type="button" class="text-light bg-transparent border border-0 position-absolute top-0 end-0 m-4 " data-bs-dismiss="offcanvas" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
        </svg>
    </button>
    <div class="offcanvas-body p-5">
        <h1>Confirm Order?</h1>
        <h5>Note: Orders are not cancellable</h5>
        <p>if you want to cancel orders please ask for staff assistance</p>
        <div class="w-100 d-flex justify-content-between text-black">
            <button class="bg-body-secondary border-0 rounded-pill py-2 px-5" data-bs-dismiss="offcanvas" aria-label="Close">CANCEL</button>
            <button class="bg-yellow border-0 rounded-pill py-2 px-5 confirm">CONFIRM</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $(document).ready(function (){
            $(".checkout").on("click", ()=> {
                const tableId = "@table";
                fetch(`/Order/ConfirmCart?id=${tableId}`)
                .then(rawData => rawData.json())
                .then(data => {
                    alert(data.message)
                    $(".order-body").empty()
                    $(".total").text("0.00")
                })
            })

            //Add confirmation
            $(".remove").on("click", function () {
                let id = $(this).data("id");
                fetch(`/Order/RemoveFromCart/${id}`)
                .then(response => response.json())
                .then(m => {
                    window.location.reload()
                })
            });

            $(".confirm").on("click", function (){
                let id = "@table"
                console.log(id)
                 fetch(`/Order/ConfirmCart/${id}`)
                .then(response => response.json())
                .then(m => {
                    console.log(m)
                    let setheight = $(".offcanvas")
                    setheight.removeClass("h-50")
                    setheight.addClass("h-75")
                    let content = $(".offcanvas-body")
                    content.empty()

                    content.append(`
                        <div class="h-100 w-100 d-flex flex-column justify-content-center text-center gap-2">
                        <img src="/Images/Check.png" height="125" width="125" class="d-block mx-auto"/>
                        <h1>Thank you for your order!</h1>
                        <p>
                            Every bite has a story,<br />
                            and we’re here to make<br />
                            sure you enjoy every taste.
                        </p>
                        <div>
                            <a class="btn btn-yellow w-100 rounded-pill mb-2" href="/Order/MyOrders/">VIEW MY ORDER</a>
                            <a class="text-decoration-none text-white" asp-controller="Home" asp-action="Index">ORDER MORE</a>
                        </div>
                    </div>
                    `)
                    var orders = @orders
                    console.log(orders)
                    $(".orders").empty();
                    $(".orders").append(`
                    <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                        <div class="d-flex flex-column justify-content-center">
                            <img src="/Images/ThinCart.png" height="170" width="170" class="mx-auto d-block" />
                            <h1 class="text-center text-wrap">Your cart is<br />waiting...</h1>
                            <p class="mt-3">Time to add what you’re craving!</p>
                        </div>
                    </div>
                    `)
                })
            })
        })
    </script>
}