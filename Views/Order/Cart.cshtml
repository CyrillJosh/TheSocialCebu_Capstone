@using System.Text.Json
@using TheSocialCebu_Capstone.Models
@model List<OrderItem>
@{
    ViewData["Title"] = "Cart";
    string table = Context.Session.GetString("Table");
    var ordersJson = Context.Session.GetString("Orders");
    var orders = string.IsNullOrEmpty(ordersJson)
          ? new List<OrderItem>()
          : JsonSerializer.Deserialize<List<OrderItem>>(ordersJson);
}
<div class="vh-100 vw-100 d-flex flex-column bg-black">
    <header class="w-100 mb-2 d-flex justify-content-between p-2">
        <!-- Back button -->
        <div class="d-flex flex-row flex-nowrap gap-0 p-2">
            <a class="bg-transparent text-primary m-0 p-0 rounded-1 d-flex align-items-center justify-content-center" style="z-index: 1; min-width: 25px"
               href="/Home/Index">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                     viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 2 5 8l6 6" />
                </svg>

            </a>
        </div>
        <!-- Title -->
        <h1 class="text-white text-center m-0 p-0 align-self-center text-arbutus">My Cart</h1>

        <!-- Cart -->
        <a class="text-decoration-none text-yellow rounded-1 gotocart position-relative align-self-end m-2 invisible" href="/Order/Cart">
            <img src="~/Images/Cart.png" class="img-fluid" style="height: 30px;">
            <span class="pill">
                @if (orders.Count() > 0)
                {
                    <span class="position-absolute top-0 mt-1 start-100 translate-middle badge rounded-pill bg-danger">
                        @orders.Count()
                        <span class="visually-hidden">unread messages</span>
                    </span>
                }
            </span>
        </a>
    </header>
    <main class="flex-grow-1 overflow-x-auto pb-5 px-3 d-flex flex-column flex-column orders"id="main">
        @if (Model.Count == 0)
        {
            <div class="h-100 w-100 text-white d-flex justify-content-center align-items-center">
                <div class="d-flex flex-column justify-content-center">
                    <img src="/Images/ThinCart.png" height="150" width="150" class="mx-auto d-block" />
                    <h1 class="text-center text-wrap text-antonio" style="font-size:8vh">Your cart is waiting...</h1>
                    <p class="mt-3 text-center text-arbutus" style="font-size:2.2vh">Time to add what you’re craving!</p>
                </div>
            </div>
        }
        else
            @foreach (var item in Model)
            {
                <div class="w-100 text-white py-3 px-4 rounded-3 my-2 mx-0 position-relative"
                     id="cart-item-@item.ProdId"
                     style="background: linear-gradient(345deg, rgba(255, 255, 255, 0.084) 48.8%, rgba(240, 240, 240, 0.284) 100%); backdrop-filter: blur(80px)">

                    <div class="row py-2">
                        <h1 class="col-12 fw-bold text-amarath">@item.Prod.ProdName.ToUpper()</h1>
                        <div class="col-6">
                            <h6 style="font-size:10px">@item.Instructions</h6>
                            <h3 class="text-arbutus" id="@("price" + item.OrderItemId)">@item.Prod.Price.ToString("₱0.00")</h3>
                        </div>
                        <div class="col-6 d-flex align-items-end pt-3">
                            <div class="w-100 rounded-pill d-flex gap-2 justify-content-center align-items-center text-black">
                                <div class="rounded-pill p-1 bi-dash" style="background:#959595" data-id="@item.OrderItemId">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi text-black @(item.Quantity == 1 ? "disabled" : "")" viewBox="0 0 16 16">
                                        <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                                    </svg>
                                </div>
                                <h5 id="@("qty" + item.OrderItemId)" class="m-0 qty text-white">@(item.Quantity?.ToString("D2") ?? "00")</h5>
                                <div class="rounded-pill p-1 bg-primary bi-plus" data-id="@item.OrderItemId">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi text-black" viewBox="0 0 16 16">
                                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button type="button" class="text-white bg-transparent border-0 position-absolute top-0 end-0 p-2 remove" data-id="@item.OrderItemId">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                             fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                            <path d="M2.146 2.854a.5.5 0 1 1 .508-.508L8 7.293l5.146-5.147a.5.5 0 0 1 .508.508L8.507 8l5.147 5.146a.5.5 0 0 1-.508.508L8 8.507l-5.146 5.147a.5.5 0 0 1-.508-.508L7.293 8z" />
                        </svg>
                    </button>
                </div>
            }
    </main>
    <!-- Bottom Navigation -->
    <footer class="w-100">
        @if (orders.Count > 0)
        {
            <button class="btn btn-primary d-block mx-auto w-75 z-5 mb-4 confirm rounded-pill" style="font-size: 2.3vh;">SUBMIT ORDERS</button>
        }
        <div class="w-100 border-top d-flex justify-content-evenly align-items-center text-white pt-4"
             style="background: #151515; min-height: 60px; padding-bottom: 10vh">
            <a class="text-decoration-none pb-1 d-flex flex-column align-items-center" href="/Home/Index">
                <img src="/Images/Home.png" class="img-fluid" style="max-height: 30px; filter: brightness(1) saturate(0%);" />
                <small class="text-white">Home</small>
            </a>
            <a class="text-decoration-none pb-1 d-flex flex-column align-items-center" href="/Order/MyOrders/@table">
                <img src="/Images/Orders.png" class="img-fluid" style="max-height: 30px; filter: brightness(1) saturate(0%);" />
                <small class="text-decoration-none text-white">Orders</small>
            </a>
        </div>
    </footer>
</div>

<!-- Offcanvas -->
<div class="offcanvas offcanvas-bottom bg-dark h-50 pb-3 rounded rounded-top-4 text-white border border-1 border-start-0 border-bottom-0 border-end-0" style="background: #2F2F2F" tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel">
    <button type="button" class="text-white bg-transparent border border-0 position-absolute top-0 end-0 m-4 " data-bs-dismiss="offcanvas" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
            <path d="M2.146 2.854a.5.5 0 1 1 .508-.508L8 7.293l5.146-5.147a.5.5 0 0 1 .508.508L8.507 8l5.147 5.146a.5.5 0 0 1-.508.508L8 8.507l-5.146 5.147a.5.5 0 0 1-.508-.508L7.293 8z" />
        </svg>
    </button>
    <div class="offcanvas-body p-5">
        <h1>Confirm Order?</h1>
        <h5>Note: Orders are not cancellable</h5>
        <p>if you want to cancel orders please ask for staff assistance</p>
        <div class="w-100 d-flex justify-content-between text-black">
            <button class="bg-body-secondary border-0 rounded-pill py-2 px-5" data-bs-dismiss="offcanvas" aria-label="Close">CANCEL</button>
            <button class="bg-yellow border-0 rounded-pill py-2 px-5 confirm">CONFIRM</button>
        </div>
    </div>
</div>
<!-- Confirm Delete Modal -->
<div class="modal fade" id="DeleteModal" tabindex="-1" aria-labelledby="DeleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white bg-gray border-0 shadow-lg">

            <!-- Header -->
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-arbutus" id="DeleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <hr/>
            <!-- Body -->
            <div class="modal-body text-center pt-2 pb-4">
                <h5 class="fw-semibold mb-3">Are you sure you want to delete:</h5>
                <h4 class="fw-bold text-yellow" id="Item">Item Name</h4>
                <p class="mt-2 text-white small">This action cannot be undone.</p>
            </div>
            <hr/>
            <!-- Footer -->
            <div class="modal-footer border-0 d-flex justify-content-center pb-4">
                <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm" id="ConfirmDelete">
                    Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function (){
            window.connection.on("DonePayment", function(table){
                let currentTable = '@table';
                if(currentTable === table){
                    console.log("Payment done for table: " + table);
                    fetch('/Order/ClearMySession', { method: 'POST' })
                    .then(() => {
                        console.log("Session cleared");
                        $("body").empty();
                        $("body").removeClass("row");
                        $("body").append(`
                            <div style="overflow: hidden; width:100vw; height:100vh; display:flex; justify-content:center; align-items:center; background-color:black;">
                                <img src="/Images/donepayment.png" alt="Payment Done" style="height: 100%; width: 100%; object-fit: cover"/>
                            </div>
                        `);
                    })
                }
            });
            $(".bi-plus").on("click", function () {
                let id =  $(this).data("id");
                fetch(`/Order/UpdateQuantity?id=${id}&type=Add`)
                .then(rawData => rawData.json())
                .then(data => {
                    const qty = $(`#qty${id}`)
                    const price = $(`#price${id}`)

                    let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                    let num = parseInt(qty.text())
                    let basePrice = currentPrice / num

                    num++

                    qty.text(num.toString().padStart(2, "0"));
                    price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))

                })
            })
            $(".bi-dash").on("click", function () {
                let id =  $(this).data("id");
                fetch(`/Order/UpdateQuantity?id=${id}&type=Minus`)
                .then(rawData => rawData.json())
                .then(data => {
                    const qty = $(`#qty${id}`)
                    const price = $(`#price${id}`)

                    let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                    let num = parseInt(qty.text())
                    let basePrice = currentPrice / num
                    if((num-1) == 0){
                        num = 1
                    }
                    else{
                        num--
                    }
                    qty.text(num.toString().padStart(2, "0"));
                    price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))
                })
            })

            // function getOrders() {
            //     let orders = sessionStorage.getItem("Orders");
            //     if (orders) {
            //         return JSON.parse(orders);
            //     }
            //     return [];
            // }

            // function saveCart(orders) {
            //     sessionStorage.setItem("Orders", JSON.stringify(orders));
            // }

            // function updateOrder(id, type) {
            //     let orders = getOrders();

            //     switch (type) {
            //         case "Add":
            //             let addOrder = orders.find(x => x.orderItemId === id);
            //             if (addOrder) {
            //                 addOrder.quantity++;
            //             }
            //             break;

            //         case "Minus":
            //             let order = orders.find(x => x.orderItemId === id);
            //             if (order) {
            //                 if (order.quantity - 1 === 0) {
            //                     order.quantity = 1;
            //                 } else {
            //                     order.quantity--;
            //                 }
            //             }
            //             break;
            //     }

            //     saveCart(orders);
            //     return { orders: orders, message: "Success" };
            // }


            //Add confirmation
            $(".remove").on("click", function () {
                let id = $(this).data("id");

                let itemName = $(this).closest(".w-100").find("h1").text().trim();

                $("#ConfirmDelete").data("id", id);
                $("#Item").text(itemName);
                $("#DeleteModal").modal("show");
            });

            $("#ConfirmDelete").on("click", function () {
                let id = $(this).data("id");

                fetch(`/Order/RemoveFromCart/${id}`)
                    .then(response => response.json())
                    .then(m => {
                        if (m.success) {
                            window.location.reload();
                        } else {
                            AlertModal("Error", m.message);
                        }
                    });
            });


            $(".confirm").on("click", () => {
                const tableId = '@table'; // Razor variable
                fetch(`/Order/ConfirmCart?tableId=${tableId}`)
                    .then(response => {
                        if (!response.ok) throw new Error("Network response was not OK");
                        return response.json();
                    })
                    .then(data => {
                        if (data.success) {

                           window.location.replace(`/Order/MyOrders/${tableId}`);
                        } else {
                            AlertModal("Error",data.message);

                            if (data.removedIds && data.removedIds.length > 0) {
                                for (const id of data.removedIds) {
                                    fetch(`/Order/RemoveFromCart/${id}`);

                                    const $item = $(`#cart-item-${id}`);
                                    if ($item.length) {
                                        $item.fadeOut(300, function() {
                                            $(this).remove();
                                        });
                                    }
                                }
                            }
                        }
                    })
                    .catch(err => "Error",err);
            });
        })
    </script>
}