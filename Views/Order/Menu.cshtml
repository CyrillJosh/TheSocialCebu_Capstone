﻿@using System.Text.Json
@using TheSocialCebu_Capstone.Models
@model List<SubCategory>
@{
    ViewData["Title"] = "Digital Menu";
    var table = Context.Session.GetString("Table");
    var ordersJson = Context.Session.GetString("Orders");
    var orders = string.IsNullOrEmpty(ordersJson)
          ? new List<OrderItem>()
          : JsonSerializer.Deserialize<List<OrderItem>>(ordersJson);
}
<style>
    #food-search:focus {
        outline: none;
        box-shadow: none;
    }

    /* Search input container */
    #search-div {
        background: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    /* Dropdown results */
    #search-dropdown {
        background: rgba(0, 0, 0, 0.75);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(12px);
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

</style>
<div class="vh-100 vw-100 d-flex flex-column"
     style="background: radial-gradient(376.79% 162.09% at 141.41% 59.77%, #000000 21.61%, #585757 56.69%, #565555 94.59%, #000000 100%);">
    <!-- Top Nav -->
    <header class="position-relative" id="navBar">
        <img src="/Images/Categories/@(Model.First().Category.CategoryName.Replace(" ", "").Replace("&", "").Replace("/", "") + ".png")" class="h-100 w-100 position-absolute object-fit-cover" style="z-index: 1" />
        <div class="h-100 w-100 position-absolute object-fit-cover" style="z-index: 1; background: linear-gradient(180deg, rgba(0, 0, 0) 0%, rgba(217, 217, 217, 0.1) 30%,rgba(0, 0, 0) 95%);"></div>
        <div class="d-flex flex-column" style="z-index: 2; position: relative;">
            <div class="w-100 mb-2 d-flex justify-content-between p-2">
                <!-- Back button -->
                <div class="d-flex flex-row flex-nowrap gap-0 p-2">
                    <a class="bg-transparent text-primary m-0 p-0 rounded-1 d-flex align-items-center justify-content-center" style="z-index: 1; min-width: 25px"
                       href="/Home/Index">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22"
                             viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M11 2 5 8l6 6" />
                        </svg>
                    </a>
                </div>
                <!-- Title -->
                <h1 class="text-white text-center m-0 p-0 align-self-center text-arbutus">@Model[0].Category.CategoryName</h1>

                <!-- Cart -->
                <a class="text-decoration-none text-yellow rounded-1 gotocart position-relative align-self-end m-2" href="/Order/Cart">
                    <img src="~/Images/Cart.png" class="img-fluid" style="height: 34px;">
                    <span class="pill">
                        @if (orders.Count() > 0)
                        {
                            <span class="position-absolute top-0 mt-1 start-100 translate-middle badge rounded-pill bg-danger">
                                @orders.Count()
                                <span class="visually-hidden">unread messages</span>
                            </span>
                        }
                    </span>
                </a>
            </div>
            <!-- Search input -->
            <div class="flex-grow-1 mx-3 border border-1 rounded-pill border-white text-white align-items-center gap-2 position-relative">
                <div class="h-100 w-100 py-2 px-3 d-flex" id="search-div">
                    <i class="bi bi-search"></i>
                    <input id="food-search" type="text"
                           placeholder="Search your favorite food"
                           class="border-0 bg-transparent text-white flex-grow-1" autocomplete="off" />
                </div>

                <!-- Dropdown for search results -->
                <div id="search-dropdown" class="position-absolute py-1 mt-1 text-white w-100 rounded-4 border border-1 border-white shadow overflow-auto"
                     style="max-height: 300px; display:none; top:100%; left:0; z-index:1050;">
                    @foreach (var i in Model.SelectMany(x => x.Products))
                    {
                        <div class="p-2 ps-4 search-item" data-id="@i.ProdId" style="cursor:pointer;">
                            @i.ProdName
                        </div>
                    }
                </div>
            </div>
            <!-- Subcategories Navigation -->
            <div class="d-flex flex-row flex-nowrap overflow-x-scroll gap-4 px-2 pb-1" id="subcat" style="scrollbar-width: none">
                @foreach (var navcat in Model.Where(x => x.Products.Any()))
                {
                    <a href="#@navcat.SubcategoryName.Replace(" ", "").Replace("&", "").Replace("/", "")"
                       class="nav-link text-white h-100 p-3 d-flex flex-column align-items-center gap-2"
                       style="width: 50px">
                        <span class="rounded rounded-5 p-2 d-flex justify-content-center bg-gray" style="box-shadow: 2px 2px 10px 0 rgba(0, 0, 0, 3); ">
                            <img src="/Images/Subcategories/@(navcat.SubcategoryName.ToString().Trim().Replace(" ", "").Replace("&", "").Replace("/", "").ToLower() + ".png")" class="object-fit-cover" style="width:40px; height:40px;" />
                        </span>
                        <p class="text-center mb-0 text-arbutus text-wrap small">
                            @navcat.SubcategoryName
                        </p>
                    </a>
                }
            </div>
        </div>
    </header>

    <!-- Product Navigation (scrollable middle content) -->
    <main class="flex-grow-1 overflow-auto pb-5 position-relative"
          data-bs-spy="scroll"
          data-bs-target="#navBar"
          id="productContainer">
        @foreach (var subcat in Model.Where(x => x.Products.Any()))
        {
            <section id="@subcat.SubcategoryName.Replace(" ", "").Replace("&", "").Replace("/", "")"
                     class="my-5 px-2 text-white text-center d-flex flex-column gap-2 text-arbutus"
                     data-id="@subcat.SubcategoryId">
                <h1>@subcat.SubcategoryName</h1>
                @foreach (var item in subcat.Products)
                {
                    <div id="@item.ProdId" class="col mx-3 border border-top-0 border-start-0 border-end-0 rounded rounded-3 @(item.Availability ? "" : "visually-hidden")"
                         style="background: linear-gradient(180deg, rgba(217, 217, 217, 0.1) 0%, rgba(115, 115, 115, 0.1) 100%);">
                        <button class="add-product px-3 py-3 w-100 h-100 m-0 bg-transparent border-0"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#offcanvasBottom"
                                data-id="@item.ProdId">
                            <div class="d-flex justify-content-between align-items-center text-white">
                                <p class="mb-0 text-start text-amarath">@item.ProdName.ToUpper()</p>
                                <span class="text-amarath">@item.Price.ToString("₱0.00")</span>
                            </div>
                        </button>
                    </div>
                }
            </section>

        }
    </main>
    <!-- Update to absolute layout -->
    <!-- Bottom Navigation -->
    <footer class="w-100 border-top pt-3 bg-secondary"
            style="padding-bottom: 10vh">
        <div class="w-100 d-flex justify-content-evenly align-items-center text-white" style="background: #151515; min-height: 60px;">
            <a class="text-decoration-none d-flex flex-column align-items-center" href="/Home/Index">
                <img src="/Images/Home.png" class="img-fluid" style="max-height: 30px;" />
                <small class="text-primary">Home</small>
            </a>
            <a class="text-decoration-none d-flex flex-column align-items-center" href="/Order/MyOrders/@table">
                <img src="/Images/Orders.png" class="img-fluid" style="max-height: 30px; filter: brightness(1) saturate(0%);" />
                <small class="text-decoration-none text-white">Orders</small>
            </a>
        </div>
    </footer>
</div>

<!-- off canvas -->
<div class="offcanvas offcanvas-bottom h-50 pb-3 rounded rounded-top-4 text-white border border-1 border-start-0 border-bottom-0 border-end-0 overflow-hidden"
     tabindex="-1" id="offcanvasBottom" aria-labelledby="offcanvasBottomLabel" style="background:#2F2F2F">

    <button type="button" class="text-white bg-transparent border border-0 position-absolute top-0 end-0 m-4 " data-bs-dismiss="offcanvas" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
            <path d="M2.146 2.854a.5.5 0 1 1 .508-.508L8 7.293l5.146-5.147a.5.5 0 0 1 .508.508L8.507 8l5.147 5.146a.5.5 0 0 1-.508.508L8 8.507l-5.146 5.147a.5.5 0 0 1-.508-.508L7.293 8z" />
        </svg>
    </button>

    <div class="offcanvas-body p-5 overflow-hidden">
        <div class="set-body mb-3">
        </div>

        <div class="w-100 row m-0 mb-3">
            <div class="set-price col-6 ps-0">
            </div>

            <div class="col-6 d-flex flex-row justify-content-between">
                <div class="rounded-pill p-1 minus" style="background:#959595">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-dash text-black" viewBox="0 0 16 16">
                        <path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8" />
                    </svg>
                </div>
                <h2 id="qty"></h2>
                <div class="rounded-pill p-1 bg-primary add">
                    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" fill="currentColor" class="bi bi-plus text-black" viewBox="0 0 16 16">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
                    </svg>
                </div>
            </div>
        </div>

        <textarea id="instructions" class="w-100 bg-transparent text-white rounded border border rounded-2 my-2" placeholder="Instructions" style="resize: none; border-color: gray; height: 8vh"></textarea>
        
        <button class="btn btn-primary col-6 p-3 add-to-order w-100 rounded-pill" data-bs-dismiss="offcanvas">ADD TO MY CART</button>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function() {
            window.connection.on("DonePayment", function(table){
                let currentTable = '@table';
                if(currentTable === table){
                    console.log("Payment done for table: " + table);
                    fetch('/Order/ClearMySession', { method: 'POST' })
                    .then(() => {
                        console.log("Session cleared");
                        $("body").empty();
                        $("body").removeClass("row");
                        $("body").append(`
                            <div style="overflow: hidden; width:100vw; height:100vh; display:flex; justify-content:center; align-items:center; background-color:black;">
                                <img src="/Images/donepayment.png" alt="Payment Done" style="height: 100%; width: 100%; object-fit: cover"/>
                            </div>
                        `);
                    })
                }
            });
            window.connection.on("NewProduct", function (prod) {
                console.log(prod)
                // Format price
                let priceFormatted = new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(prod.price);

                // Build product card HTML
                let content = `
                <div id="${prod.prodId}" class="col mx-3 border border-top-0 border-start-0 border-end-0 rounded-3"
                     style="background: linear-gradient(180deg, rgba(217, 217, 217, 0.1) 0%, rgba(115, 115, 115, 0.1) 100%);">
                    <button class="add-product px-3 py-3 w-100 h-100 m-0 bg-transparent border-0"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#offcanvasBottom"
                            data-id="${prod.prodId}">
                        <div class="d-flex justify-content-between align-items-center text-white">
                            <p class="mb-0 text-start">${prod.prodName.toUpperCase()}</p>
                            <span>${priceFormatted}</span>
                        </div>
                    </button>
                </div>`;

                // Find subcategory section using jQuery
                let $subcatSection = $(`section[data-id='${prod.subcategoryId}']`);
                if ($subcatSection.length) {
                    $subcatSection.append(content);
                } else {
                    console.warn("Subcategory section not found for ID:", prod.subcategoryId);
                }
            });

             window.connection.on("UpdateProductStatus", function (prodid, prodstat) {
                 if(prodstat){
                    $(`#${prodid}`).removeClass("visually-hidden");
                 }
                 else{
                    $(`#${prodid}`).addClass("visually-hidden");
                 }
            });


            const searchInput = $("#food-search");
            const dropdown = $("#search-dropdown");

            // Hide dropdown initially
            dropdown.hide();

            searchInput.on("input", function () {
                const query = $(this).val().toLowerCase();

                let hasMatch = false;
                dropdown.children(".search-item").each(function () {
                    const name = $(this).text().toLowerCase();
                    if(name.includes(query)) {
                        $(this).show();
                        hasMatch = true;
                    } else {
                        $(this).hide();
                    }
                });
                // Remove previous "no results" message
                dropdown.children(".no-results").remove();

                if(!hasMatch){
                    dropdown.append('<div class="p-2 ps-4 text-white bg-transparent no-results">No results found</div>');
                }

                // Ensure dropdown is visible
                if(query.length > 0) {
                    dropdown.show();
                    dropdown.css("min-height", "40px"); // ensures "no results" is visible
                } else {
                    dropdown.hide();
                }
            });
            // Click a result to trigger offcanvas
            dropdown.on("click", ".search-item", function() {
                const id = $(this).data("id");
                $(".add-product[data-id='"+id+"']").trigger("click"); // triggers your existing offcanvas
                dropdown.hide();
                searchInput.val("");
            });

            // Hide dropdown when clicking outside
            $(document).click(function(e) {
                if(!$(e.target).closest("#food-search, #search-dropdown").length){
                    dropdown.hide();
                }
            });
            // ScrollSpy
            $("#subcat a span").first().addClass("bg-white")

            $("#productContainer").on("scroll", function() {
                const top = $(this).scrollTop();
                $("section").each(function() {
                    const previousSiblings = $(this).prevAll();
                    const heightsArray = previousSiblings.map(function() {
                        return $(this).outerHeight(true);
                    }).get();

                    let totalPreviousHeight = 0;
                    heightsArray.forEach(height => {
                        totalPreviousHeight += height;
                    });
                    if(top-50 < totalPreviousHeight && top+50 > totalPreviousHeight){
                        $("#subcat a span").removeClass("bg-white")
                        $("#subcat a span").addClass("bg-gray")
                        $(`#subcat a[href^="#${$(this).attr("id")}"] span`).addClass("bg-white")
                    }

                    if($(this)[0] == $("section").last()[0] && top + $("#productContainer").height() + 100 >= $("#productContainer").prop('scrollHeight')){
                        $("#subcat a span").removeClass("bg-white")
                        $("#subcat a span").addClass("bg-gray")
                        $(`#subcat a[href^="#${$(this).attr("id")}"] span`).addClass("bg-white")
                    }
                });
            });

            $('a[href^="#"]').on('click', function(event) {
                event.preventDefault();

                var targetSection = $(this.hash);
                var container = $("#productContainer");
                var scrollPosition = 0;

                // Iterate through all the sections
                $('section').each(function() {
                    if ($(this).attr('id') === targetSection.attr('id')) {
                        return false; // This breaks the .each() loop
                    }
                    scrollPosition += $(this).outerHeight(true);
                });
                container.animate({
                    scrollTop: scrollPosition
                }, 500);
            });

            $(".gotocart").on("click", () => {
                windows.location.href = $(this).attr('href')
            })

             $(document).on("click", ".add-product, .search-item", function() {
                let id =  $(this).data("id");
                fetch(`/Order/Preview?id=${id}`)
                .then(response => response.json())
                .then(prod => {
                    if(prod.success){
                        $("#qty").text("01")
                        $(".set-body").empty()
                        $(".set-header").empty()
                        $(".set-price").empty()
                        $("#instructions").val("")

                        $(".add-to-order").data("id",prod.prodId);

                        $(".set-body").append(`<h1 class="text-amarath fw-bold">${prod.prodName.toUpperCase()}</h1>`)
                        // $(".set-body").append(`<p>${prod.description}</p>`)
                        $(".set-price").append(`<h2 class="text-amarath" id="price">${prod.price.toLocaleString("en-PH", { style: "currency", currency: "PHP" })}</h2>`)

                        $(".add-to-order").data("id", prod.prodId);
                    }
                    else{
                        AlertModal("Error",m.message);
                    }
                })
            })
            //Add
            $(".add").on("click", ()=> {
                const qty = $("#qty")
                const price = $("#price")
                let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                let num = parseInt(qty.text())
                let basePrice = currentPrice / num
                num++
                qty.text(num.toString().padStart(2, "0"));
                price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))
            })
            //Minus
             $(".minus").on("click", ()=> {
                const qty = $("#qty")
                let num = parseInt(qty.text())
                const price = $("#price")
                let currentPrice = parseFloat(price.text().replace(/[^0-9.-]+/g,""))
                let basePrice = currentPrice / num
                if((num-1) == 0){
                    num = 1
                }
                else{
                    num--
                }
                qty.text(num.toString().padStart(2, "0"));
                price.text((basePrice * num).toLocaleString("en-PH", { style: "currency", currency: "PHP" }))
            })
            const addtoorder = $(".add-to-order")
            addtoorder.on("click", () => {
                let id = addtoorder.data("id");
                let qty = $("#qty").text();
                let ins = $("#instructions").val();
                fetch(`/Order/AddToCart?id=${id}&qty=${qty}&ins=${ins}`)
                .then(rawData => rawData.json())
                .then(data => {
                    if (data.redirect) {
                        window.location.href = data.redirect;
                        return;
                    }
                    if(data.success){
                        let pill = $(".pill")
                        pill.empty()
                        let count = data["orders"].length
                        pill.append(`<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            ${count}
                            <span class="visually-hidden">unread messages</span>
                        </span>`)
                    }
                    else{
                        AlertModal("Error",data.message)
                    }
                })
            })
        })
    </script>
}