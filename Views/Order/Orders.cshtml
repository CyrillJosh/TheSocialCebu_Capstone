@using TheSocialCebu_Capstone.Models.OrderClasses
@{
	ViewData["Title"] = "Orders";
}
@model List<Order>
<div class="render-body">
	<div class="p-4">
		<div class="d-flex justify-content-between">
			<h1>Orders</h1>
			<h3>@DateTime.Now.ToString("MMMM, dd, yyyy")</h3>
		</div>

		<div class="d-flex">
			<div>
				<button>All</button>
				<button>On Process</button>
				<button>Completed</button>
			</div>
			<div>
				<div class="row h-50 input-group gap-2 m-2 d-flex justify-content-end">
					<div class="border border-2 rounded-pill border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
							<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
						</svg>
						<input id="custom-search-input" type="text" placeholder="Search" class="border-0 focus-none bg-transparent m-0 p-0" />
					</div>
				</div>
			</div>
		</div>
		<div class="row row-cols-2">
			@foreach(var item in Model)
			{
				<div class="card col">
					<div class="card-header">
						<p>@item.Table.TableNumber</p>
						<p>@item.OrderId</p>
					</div>
					<div class="card-body">
						<div>
						@foreach(var order in item.OrderItems)
						{
							<p>@order.Prod.ProdName</p>
							<p>@order.Qty</p>
							<p>@order.Prod.Price</p>
						}
						</div>
						<div>
							<p>Total</p>
							<p>@item.OrderItems.Sum(x => x.Prod.Price * x.Qty)</p>
						</div>
					</div>
					<div class="card-footer">
						<div>
							<button class="btn btn-primary confirm" data-id="@item.TableId">Confirm</button>
							<button class="btn btn-yellow confirm" data-id="@item.TableId">Pay Bills</button>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
</div>
@section Scripts{
	<script>
		$(document).ready( function () {
			const
		})
	</script>
}
