@using TheSocialCebu_Capstone.Models.TableClasses
@{
	ViewData["Title"] = "Orders";
}
@model List<Table>
<div class="render-body vh-100">
	<div class="p-4 h-100">
		@* <div class="d-flex justify-content-between">
			<h1>Orders</h1>
			<h3>@DateTime.Now.ToString("MMMM, dd, yyyy")</h3>
		</div> *@

		@* <div class="d-flex">
			<div>
				<button>All</button>
				<button>On Process</button>
				<button>Completed</button>
			</div>
			<div>
				<div class="row h-50 input-group gap-2 m-2 d-flex justify-content-end">
					<div class="border border-2 rounded-pill border-dark px-2 py-1 col-xl-4 col-md-12 d-flex align-items-center gap-1">
						<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-search m-0 p-0" viewBox="0 0 16 16">
							<path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001q.044.06.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1 1 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0" />
						</svg>
						<input id="custom-search-input" type="text" placeholder="Search" class="border-0 focus-none bg-transparent m-0 p-0" />
					</div>
				</div>
			</div>
		</div> *@
		<div class="row row-cols-2 ">
			<h1>Approved Orders</h1>
			<div class="col-9 d-flex flex-column gap-3">
				@foreach(var item in Model.Where(x => x.Orders.Count > 0))
				{
					<div class="border border-1 shadow rounded-3 p-3">
						<div>
							<div class="bg-primary d-flex justify-content-center align-items-center">
								<p>@item.TableNumber</p>
							</div>
							@* <p>@item.OrderId</p> *@
						</div>
						<hr />
						<div>
							<div>
								<table class="table table-bordered">
									<thead>
										<tr>
											<th>Product</th>
											<th>Quantity</th>
											<th>Price</th>
											<th>Subtotal</th>
											<th>Status</th>
										</tr>
									</thead>
									<tbody>
									@foreach(var order in item.Orders.Where(x => x.Status == false))
									{
										@foreach(var orderitem in order.OrderItems)
										{
											<tr>
												<td>@orderitem.Prod.ProdName</td>
												<td>@orderitem.Quantity</td>
												<td>@orderitem.Prod.Price</td>
												<td>@(orderitem.Prod.Price* orderitem.Quantity)</td>
												<td>@order.Status</td>
											</tr>
										}
									}
									</tbody>
								</table>
							</div>
							<div class="d-flex justify-content-between">
								<p>Total:</p>
								<p>@item.Orders.Where(x => x.Status == false).Sum(x => x.OrderItems.Sum(y => y.Prod.Price * y.Quantity))</p>
							</div>
						</div>
						<hr />
						<div>
							<div>
								@* <button class="btn btn-primary confirm" data-id="@item.Id">Confirm</button> *@
								@* <button class="btn btn-yellow confirm" data-id="@item.Id">Pay Bills</button> *@
							</div>
						</div>
					</div>
				}
			</div>
			<div class="col-3">
				<h1 class="text-center">Pending</h1>
				<div class="d-flex flex-column gap-3">
				@foreach (var item in Model)
				{
					@foreach (var order in item.Orders.Where(x => x.Status == false))
					{
						<div class="border border-1 shadow rounded-3 p-3">
							<div>
								<div class="hstack justify-content-between">
									<h2>@item.TableNumber</h2>
									<button class="btn btn-primary confirm" data-id="@order.OrderId">Confirm</button>
								</div>
								<table class="table table-bordered">
									<thead>
										<tr>
											<th>Product</th>
											<th>Quantity</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var orderitem in order.OrderItems)
										{

											<tr>
												<td>@orderitem.Prod.ProdName</td>
												<td>@orderitem.Quantity</td>
											</tr>
										}
									</tbody>
								</table>
							</div>
						</div>
					}
				}
				</div>
			</div>
		</div>
	</div>
</div>
@section Scripts{
	<script>
		$(document).ready( function () {
			const buttons = $(".confirm")
			$.each(buttons, (index, value) => {
				let button = value;
				button.addEventListener("click", (e) =>{
					let id =  e.currentTarget.dataset.id;
					fetch(`/Order/ConfirmOrder?id=${id}&status=In Progress`)
					.then(response => response.json())
					.then(confirm => {
						console.log(confirm)
						if(confirm.message == "OK"){
							window.location.reload();
						}
					})
				})
			})
		})
	</script>
}
